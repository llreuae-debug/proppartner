      target_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md animate-in fade-in\">\n      <div className=\"bg-[#12121c] border border-[#7c5cff]/30 rounded-2xl w-full max-w-3xl max-h-[88vh] flex flex-col shadow-2xl overflow-hidden shadow-[#7c5cff]/10\">\n        {/* Modal Header */}\n        <div className=\"h-16 border-b border-white/10 px-6 flex items-center justify-between bg-gradient-to-r from-[#171728] to-[#12121c] shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-[#7c5cff]/20 border border-[#7c5cff]/40 flex items-center justify-center text-[#9bb8ff]\">\n              <Sparkles className=\"w-4 h-4 text-[#7c5cff]\" />\n            </div>\n            <div>\n              <div className=\"font-bold text-sm text-white flex items-center gap-2\">\n                Hostinger Architecture Audit\n                <span className=\"text-[10px] uppercase font-mono px-2 py-0.5 rounded-full bg-[#7c5cff]/20 text-[#c5b5ff] border border-[#7c5cff]/30\">\n                  AI Powered\n                </span>\n              </div>\n              <div className=\"text-xs text-white/50\">Custom infrastructure guidance for Hostinger deployment</div>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-lg flex items-center justify-center text-white/50 hover:text-white hover:bg-white/10 transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-5\">\n          {isLoading ? (\n            <div className=\"flex flex-col items-center justify-center py-16 text-center space-y-4\">\n              <div className=\"w-10 h-10 border-2 border-[#7c5cff]/30 border-t-[#7c5cff] rounded-full animate-spin\" />\n              <div className=\"text-sm font-semibold text-white\">Analyzing stack with Gemini 3.7 Flash...</div>\n              <div className=\"text-xs text-white/40 max-w-sm\">\n                Evaluating database drivers, routing strategies, and Hostinger runtime optimization rules.\n              </div>\n            </div>\n          ) : audit ? (\n            <>\n              {/* Recommended Plan */}\n              <div className=\"p-4 rounded-xl bg-gradient-to-r from-[#5b8cff]/10 to-[#7c5cff]/10 border border-[#5b8cff]/30\">\n                <div className=\"flex items-center gap-2 text-xs font-bold text-[#9bb8ff] uppercase tracking-wider mb-1 font-mono\">\n                  <Server className=\"w-4 h-4 text-[#5b8cff]\" />\n                  Recommended Hostinger Tier\n                </div>\n                <div className=\"text-lg font-extrabold text-white mb-1\">\n                  {audit.recommendedHostingerPlan}\n                </div>\n                <div className=\"text-xs text-white/70 leading-relaxed\">{audit.hostingerPlanReason}</div>\n              </div>\n\n              {/* Crucial Steps */}\n              <div>\n                <h4 className=\"text-xs font-bold uppercase tracking-wider text-white/60 font-mono mb-3\">\n                  Optimal hPanel Deployment Workflow\n                </h4>\n                <div className=\"space-y-2\">\n                  {audit.crucialSteps.map((step, i) => (\n                    <div\n                      key={i}\n                      className=\"flex items-start gap-3 p-3 rounded-xl bg-white/[0.02] border border-white/5 text-xs text-white/80\"\n                    >\n                      <span className=\"w-5 h-5 rounded-full bg-[#3ddc8c]/20 text-[#3ddc8c] flex items-center justify-center text-[10px] font-bold font-mono shrink-0 mt-0.5\">\n                        {i + 1}\n                      </span>\n                      <span className=\"leading-relaxed\">{step}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Pitfalls & Security Notes */}\n              {audit.potentialPitfalls && audit.potentialPitfalls.length > 0 && (\n                <div>\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-[#ffb547] font-mono mb-3 flex items-center gap-1.5\">\n                    <AlertTriangle className=\"w-3.5 h-3.5\" />\n                    Hostinger Production Watchouts\n                  </h4>\n                  <div className=\"space-y-2\">\n                    {audit.potentialPitfalls.map((pitfall, i) => (\n                      <div\n                        key={i}\n                        className=\"p-3 rounded-xl bg-[#ffb547]/5 border border-[#ffb547]/20 text-xs text-white/80 leading-relaxed\"\n                      >\n                        \342\200\242 {pitfall}\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n              {/* Htaccess Tip */}\n              {audit.recommendedHtaccessNotes && (\n                <div className=\"p-3.5 rounded-xl bg-white/[0.03] border border-white/10 text-xs text-white/70\">\n                  <div className=\"font-semibold text-white/90 mb-1 flex items-center gap-1.5\">\n                    <ShieldCheck className=\"w-4 h-4 text-[#3ddc8c]\" />\n                    Server Routing & .htaccess Strategy\n                  </div>\n                  {audit.recommendedHtaccessNotes}\n                </div>\n              )}\n            </>\n          ) : (\n            <div className=\"text-center py-12 text-white/40 text-xs\">\n              No audit report available. Please rerun AI Audit.\n            </div>\n          )}\n        </div>\n\n        <div className=\"p-4 border-t border-white/10 bg-[#141420] flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-xl text-xs font-semibold bg-[#5b8cff] text-white hover:bg-[#4a7de8] transition-colors\"\n          >\n            Done\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-in fade-in\">\n      <div className=\"bg-slate-900 border border-indigo-500/30 rounded-3xl w-full max-w-3xl max-h-[88vh] flex flex-col shadow-2xl overflow-hidden shadow-indigo-500/10\">\n        {/* Modal Header */}\n        <div className=\"h-16 border-b border-slate-800 px-6 flex items-center justify-between bg-slate-950/80 shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-300\">\n              <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n            </div>\n            <div>\n              <div className=\"font-bold text-sm text-white flex items-center gap-2\">\n                Hostinger Architecture Audit\n                <span className=\"text-[10px] uppercase font-mono px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n                  AI Powered\n                </span>\n              </div>\n              <div className=\"text-xs text-slate-400\">Custom infrastructure guidance for Hostinger deployment</div>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-xl flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-5\">\n          {isLoading ? (\n            <div className=\"flex flex-col items-center justify-center py-16 text-center space-y-4\">\n              <div className=\"w-10 h-10 border-2 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin\" />\n              <div className=\"text-sm font-semibold text-white\">Analyzing stack with Gemini 2.5 Flash...</div>\n              <div className=\"text-xs text-slate-400 max-w-sm\">\n                Evaluating database drivers, routing strategies, and Hostinger runtime optimization rules.\n              </div>\n            </div>\n          ) : audit ? (\n            <>\n              {/* Recommended Plan */}\n              <div className=\"p-5 rounded-2xl bg-indigo-600/10 border border-indigo-500/30 shadow-sm\">\n                <div className=\"flex items-center gap-2 text-xs font-bold text-indigo-300 uppercase tracking-wider mb-1 font-mono\">\n                  <Server className=\"w-4 h-4 text-indigo-400\" />\n                  Recommended Hostinger Tier\n                </div>\n                <div className=\"text-lg font-extrabold text-white mb-1\">\n                  {audit.recommendedHostingerPlan}\n                </div>\n                <div className=\"text-xs text-slate-300 leading-relaxed\">{audit.hostingerPlanReason}</div>\n              </div>\n\n              {/* Crucial Steps */}\n              <div>\n                <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono mb-3\">\n                  Optimal hPanel Deployment Workflow\n                </h4>\n                <div className=\"space-y-2\">\n                  {audit.crucialSteps.map((step, i) => (\n                    <div\n                      key={i}\n                      className=\"flex items-start gap-3 p-3.5 rounded-2xl bg-slate-950/60 border border-slate-800 text-xs text-slate-200\"\n                    >\n                      <span className=\"w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold font-mono shrink-0 mt-0.5\">\n                        {i + 1}\n                      </span>\n                      <span className=\"leading-relaxed\">{step}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Pitfalls & Security Notes */}\n              {audit.potentialPitfalls && audit.potentialPitfalls.length > 0 && (\n                <div>\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-amber-400 font-mono mb-3 flex items-center gap-1.5\">\n                    <AlertTriangle className=\"w-3.5 h-3.5\" />\n                    Hostinger Production Watchouts\n                  </h4>\n                  <div className=\"space-y-2\">\n                    {audit.potentialPitfalls.map((pitfall, i) => (\n                      <div\n                        key={i}\n                        className=\"p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-xs text-slate-200 leading-relaxed\"\n                      >\n                        \342\200\242 {pitfall}\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n              {/* Htaccess Tip */}\n              {audit.recommendedHtaccessNotes && (\n                <div className=\"p-4 rounded-2xl bg-slate-950/60 border border-slate-800 text-xs text-slate-300\">\n                  <div className=\"font-semibold text-slate-200 mb-1 flex items-center gap-1.5\">\n                    <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n                    Server Routing &amp; .htaccess Strategy\n                  </div>\n                  {audit.recommendedHtaccessNotes}\n                </div>\n              )}\n            </>\n          ) : (\n            <div className=\"text-center py-12 text-slate-500 text-xs\">\n              No audit report available. Please rerun AI Audit.\n            </div>\n          )}\n        </div>\n\n        <div className=\"p-4 border-t border-slate-800 bg-slate-950/80 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-5 py-2 rounded-xl text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-500 transition-colors shadow-md shadow-indigo-600/20\"\n          >\n            Done\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
