  file_change {
    absolute_path_uri: "file:///src/components/views/PreviewView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport {\n  Monitor,\n  Tablet,\n  Smartphone,\n  RotateCw,\n  ExternalLink,\n  ShieldCheck,\n  DownloadCloud,\n  BookmarkPlus,\n  ArrowLeft,\n  Eye,\n  Layers,\n} from \'lucide-react\';\nimport { AnalysisResult, ProjectData } from \'../../types\';\n\ninterface PreviewViewProps {\n  project: ProjectData;\n  analysis: AnalysisResult;\n  onSaveHistory: () => void;\n  onDownloadZip: () => void;\n  onPrev: () => void;\n}\n\ntype DeviceMode = \'desktop\' | \'tablet\' | \'mobile\';\n\nexport const PreviewView: React.FC<PreviewViewProps> = ({\n  project,\n  analysis,\n  onSaveHistory,\n  onDownloadZip,\n  onPrev,\n}) => {\n  const [device, setDevice] = useState<DeviceMode>(\'desktop\');\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  // Generate self-contained HTML srcdoc by inlining relative stylesheets and basic script tags\n  const srcDocContent = useMemo(() => {\n    const files = project.files;\n    const htmlFile = files[\'index.html\'] || files[\'public_html/index.html\'];\n    if (!htmlFile || !htmlFile.content) {\n      return `<!DOCTYPE html><html><body style=\"background:#09090f;color:#fff;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;\"><div style=\"text-align:center;padding:20px;\"><h3>Live Preview Ready</h3><p style=\"color:#888;font-size:13px;\">This project relies on runtime build tools. Extracted static index is ready for Hostinger.</p></div></body></html>`;\n    }\n\n    let html = htmlFile.content;\n\n    // Inline CSS files\n    html = html.replace(/<link[^>]*href=[\"\']([^\"\']+\\.css)[\"\'][^>]*>/gi, (match, cssPath) => {\n      const cleanPath = cssPath.replace(/^\\.\\//, \'\').replace(/^\\//, \'\');\n      const foundFile = Object.entries(files).find(\n        ([p]) => p === cleanPath || p.endsWith(`/${cleanPath}`) || p.endsWith(cleanPath)\n      );\n      if (foundFile && foundFile[1].content) {\n        return `<style>\\n/* Inlined: ${cleanPath} */\\n${foundFile[1].content}\\n</style>`;\n      }\n      return match;\n    });\n\n    return html;\n  }, [project.files, refreshKey]);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Eye className=\"w-5 h-5 text-[#5b8cff]\" />\n            Production Simulator &amp; Live Sandbox\n          </h1>\n          <p className=\"text-xs text-white/50 mt-1\">\n            Simulate how your converted web application renders on Hostinger web servers.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={onSaveHistory}\n            className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-white transition-colors\"\n          >\n            <BookmarkPlus className=\"w-4 h-4 text-[#3ddc8c]\" />\n            <span>Save to History</span>\n          </button>\n\n          <button\n            onClick={onDownloadZip}\n            className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-[#5b8cff] hover:bg-[#4a7de8] text-white transition-colors shadow-md shadow-[#5b8cff]/20\"\n          >\n            <DownloadCloud className=\"w-4 h-4\" />\n            <span>Download ZIP</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Interactive Browser Frame */}\n      <div className=\"rounded-2xl border border-white/10 bg-[#12121c] overflow-hidden shadow-2xl flex flex-col\">\n        {/* Browser Top Toolbar */}\n        <div className=\"p-3 border-b border-white/10 bg-[#161624] flex items-center justify-between gap-3 shrink-0 flex-wrap\">\n          {/* Device Switcher */}\n          <div className=\"flex items-center gap-1 bg-black/40 p-1 rounded-xl border border-white/10\">\n            <button\n              onClick={() => setDevice(\'desktop\')}\n              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium transition-all ${\n                device === \'desktop\'\n                  ? \'bg-[#5b8cff] text-white shadow-sm\'\n                  : \'text-white/50 hover:text-white\'\n              }`}\n            >\n              <Monitor className=\"w-3.5 h-3.5\" />\n              <span>Desktop</span>\n            </button>\n\n            <button\n              onClick={() => setDevice(\'tablet\')}\n              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium transition-all ${\n                device === \'tablet\'\n                  ? \'bg-[#5b8cff] text-white shadow-sm\'\n                  : \'text-white/50 hover:text-white\'\n              }`}\n            >\n              <Tablet className=\"w-3.5 h-3.5\" />\n              <span>Tablet (768px)</span>\n            </button>\n\n            <button\n              onClick={() => setDevice(\'mobile\')}\n              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium transition-all ${\n                device === \'mobile\'\n                  ? \'bg-[#5b8cff] text-white shadow-sm\'\n                  : \'text-white/50 hover:text-white\'\n              }`}\n            >\n              <Smartphone className=\"w-3.5 h-3.5\" />\n              <span>Mobile (375px)</span>\n            </button>\n          </div>\n\n          {/* Simulated URL Bar */}\n          <div className=\"flex-1 min-w-[200px] flex items-center gap-2 px-3 py-1.5 rounded-xl bg-black/50 border border-white/10 text-xs font-mono text-white/60\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-[#3ddc8c] shrink-0\" />\n            <span className=\"text-[#3ddc8c]\">https://</span>\n            <span className=\"text-white/90 truncate\">your-domain.hostingerapp.com/</span>\n          </div>\n\n          {/* Refresh Button */}\n          <button\n            onClick={() => setRefreshKey((k) => k + 1)}\n            className=\"w-8 h-8 rounded-lg flex items-center justify-center text-white/60 hover:text-white bg-white/5 hover:bg-white/10 transition-colors shrink-0\"\n            title=\"Reload Preview\"\n          >\n            <RotateCw className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {/* Viewport Sandbox Canvas */}\n        <div className=\"p-4 bg-[#09090d] flex items-center justify-center min-h-[520px] overflow-auto\">\n          <div\n            className=\"bg-white rounded-xl shadow-2xl overflow-hidden transition-all duration-300 border border-black/20\"\n            style={{\n              width: device === \'desktop\' ? \'100%\' : device === \'tablet\' ? \'768px\' : \'375px\',\n              height: \'520px\',\n            }}\n          >\n            <iframe\n              key={refreshKey}\n              title=\"Hostinger Deployment Live Preview\"\n              srcDoc={srcDocContent}\n              sandbox=\"allow-scripts allow-same-origin\"\n              className=\"w-full h-full border-0 bg-white\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Simulator Notes Card */}\n      <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10\">\n        <h3 className=\"text-xs font-bold uppercase tracking-wider text-white font-mono mb-2 flex items-center gap-2\">\n          <Layers className=\"w-3.5 h-3.5 text-[#5b8cff]\" />\n          Production Simulation Notes\n        </h3>\n        <ul className=\"text-xs text-white/60 space-y-1.5 list-disc list-inside leading-relaxed\">\n          <li>Renders verified HTML, linked inlined CSS stylesheets, and normalized asset paths.</li>\n          <li>For full backend database queries or server APIs (Node/Express), deploy the package on Hostinger to execute server code.</li>\n          <li>The included <code className=\"text-[#9bb8ff] font-mono\">.htaccess</code> file will automatically prevent 404s when users refresh client-side routes in production.</li>\n        </ul>\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-2\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] text-white transition-colors border border-white/10\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Download Center</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
