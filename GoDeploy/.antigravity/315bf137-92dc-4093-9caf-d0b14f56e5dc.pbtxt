    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  Github,\n  GitBranch,\n  FolderTree,\n  KeyRound,\n  ArrowRight,\n  Sparkles,\n  AlertCircle,\n  CheckCircle2,\n  Lock,\n  Star,\n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n} from \'lucide-react\';\nimport { fetchGitHubRepo, POPULAR_GITHUB_STARTERS, GitHubQuickTemplate } from \'../utils/github\';\nimport { ProjectData } from \'../types\';\nimport { useI18n } from \'../i18n/context\';\n\ninterface GitHubImportCardProps {\n  onImportProject: (project: ProjectData) => void;\n  onShowToast?: (msg: string, type: \'success\' | \'error\' | \'info\' | \'warn\') => void;\n}\n\nexport const GitHubImportCard: React.FC<GitHubImportCardProps> = ({\n  onImportProject,\n  onShowToast,\n}) => {\n  const { t } = useI18n();\n\n  const [repoInput, setRepoInput] = useState(\'\');\n  const [branch, setBranch] = useState(\'\');\n  const [subpath, setSubpath] = useState(\'\');\n  const [token, setToken] = useState(() => {\n    try {\n      return localStorage.getItem(\'godeploy_github_pat\') || \'\';\n    } catch {\n      return \'\';\n    }\n  });\n  const [showAdvanced, setShowAdvanced] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n  const [statusStep, setStatusStep] = useState<string>(\'\');\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  const handleTokenChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = e.target.value;\n    setToken(val);\n    try {\n      if (val.trim()) {\n        localStorage.setItem(\'godeploy_github_pat\', val.trim());\n      } else {\n        localStorage.removeItem(\'godeploy_github_pat\');\n      }\n    } catch {\n      // ignore\n    }\n  };\n\n  const handleImport = async (e?: React.FormEvent) => {\n    if (e) e.preventDefault();\n    if (!repoInput.trim()) return;\n\n    setErrorMsg(null);\n    setIsLoading(true);\n    setStatusStep(\'Connecting to GitHub...\');\n\n    try {\n      const result = await fetchGitHubRepo(repoInput.trim(), {\n        branch: branch.trim() || undefined,\n        subpath: subpath.trim() || undefined,\n        token: token.trim() || undefined,\n        onProgress: (step) => setStatusStep(step),\n      });\n\n      if (onShowToast) {\n        onShowToast(\n          `Successfully pulled ${result.details.fullName} (${result.project.fileCount} files)`,\n          \'success\'\n        );\n      }\n\n      onImportProject(result.project);\n    } catch (err: any) {\n      const msg = err.message || \'Failed to import repository from GitHub\';\n      setErrorMsg(msg);\n      if (onShowToast) {\n        onShowToast(msg, \'error\');\n      }\n    } finally {\n      setIsLoading(false);\n      setStatusStep(\'\');\n    }\n  };\n\n  const handleSelectStarter = (starter: GitHubQuickTemplate) => {\n    setRepoInput(starter.repo);\n    setBranch(starter.branch || \'\');\n    setSubpath(starter.subpath || \'\');\n    setShowAdvanced(Boolean(starter.branch || starter.subpath));\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Main Connection Form Card */}\n      <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm relative overflow-hidden\">\n        {/* Subtle glowing corner */}\n        <div className=\"absolute top-0 right-0 w-36 h-36 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none\" />\n\n        <div className=\"flex items-center justify-between mb-2\">\n          <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n            <Github className=\"w-4 h-4 text-white\" />\n            <span>{t(\'import.github_title\')}</span>\n          </h2>\n          <span className=\"text-[11px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full flex items-center gap-1\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n            Direct Sync\n          </span>\n        </div>\n\n        <p className=\"text-xs text-slate-400 mb-4 leading-relaxed\">\n          {t(\'import.github_subtitle\')}\n        </p>\n\n        <form onSubmit={handleImport} className=\"space-y-3.5\">\n          {/* Main Repo URL Input */}\n          <div>\n            <label className=\"block text-xs font-medium text-slate-300 mb-1.5 flex items-center justify-between\">\n              <span>Repository URL or Slug</span>\n              <span className=\"text-[11px] text-slate-500 font-mono\">e.g. owner/repo</span>\n            </label>\n            <div className=\"relative\">\n              <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500\">\n                <Github className=\"w-4 h-4\" />\n              </div>\n              <input\n                type=\"text\"\n                value={repoInput}\n                onChange={(e) => {\n                  setRepoInput(e.target.value);\n                  if (errorMsg) setErrorMsg(null);\n                }}\n                placeholder={t(\'import.github_placeholder\')}\n                className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 font-mono transition-all\"\n                disabled={isLoading}\n              />\n            </div>\n          </div>\n\n          {/* Advanced options accordion toggle */}\n          <div className=\"pt-1\">\n            <button\n              type=\"button\"\n              onClick={() => setShowAdvanced(!showAdvanced)}\n              className=\"text-xs text-indigo-400 hover:text-indigo-300 font-medium flex items-center gap-1 transition-colors\"\n            >\n              <span>{showAdvanced ? \'Hide advanced settings\' : \'Branch, Subfolder & Private Token\'}</span>\n              {showAdvanced ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n            </button>\n\n            {showAdvanced && (\n              <div className=\"mt-3 p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 space-y-3 animate-in fade-in slide-in-from-top-1 duration-200\">\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  {/* Branch Input */}\n                  <div>\n                    <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5\">\n                      <GitBranch className=\"w-3.5 h-3.5 text-indigo-400\" />\n                      <span>{t(\'import.github_branch\')}</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={branch}\n                      onChange={(e) => setBranch(e.target.value)}\n                      placeholder=\"e.g. main, dev, or release/v1.0\"\n                      className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                      disabled={isLoading}\n                    />\n                  </div>\n\n                  {/* Subfolder Input */}\n                  <div>\n                    <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5\">\n                      <FolderTree className=\"w-3.5 h-3.5 text-indigo-400\" />\n                      <span>{t(\'import.github_subpath\')}</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={subpath}\n                      onChange={(e) => setSubpath(e.target.value)}\n                      placeholder=\"e.g. client, frontend, apps/web\"\n                      className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                      disabled={isLoading}\n                    />\n                  </div>\n                </div>\n\n                {/* Personal Access Token Input */}\n                <div>\n                  <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center justify-between\">\n                    <span className=\"flex items-center gap-1.5\">\n                      <KeyRound className=\"w-3.5 h-3.5 text-amber-400\" />\n                      <span>{t(\'import.github_token\')}</span>\n                    </span>\n                    <span className=\"text-[10px] text-slate-500 flex items-center gap-1\">\n                      <Lock className=\"w-3 h-3\" /> Saved locally\n                    </span>\n                  </label>\n                  <input\n                    type=\"password\"\n                    value={token}\n                    onChange={handleTokenChange}\n                    placeholder=\"ghp_xxxxxxxxxxxxxxxxxxxx (Optional for private repos)\"\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                    disabled={isLoading}\n                  />\n                  <p className=\"text-[10px] text-slate-500 mt-1\">\n                    {t(\'import.github_token_hint\')}\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Error Message Box */}\n          {errorMsg && (\n            <div className=\"p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs flex items-start gap-2 animate-in fade-in duration-150\">\n              <AlertCircle className=\"w-4 h-4 text-rose-400 shrink-0 mt-0.5\" />\n              <div className=\"leading-normal\">\n                <span className=\"font-semibold\">GitHub Import Error: </span>\n                {errorMsg}\n              </div>\n            </div>\n          )}\n\n          {/* Submit Button */}\n          <button\n            type=\"submit\"\n            disabled={isLoading || !repoInput.trim()}\n            className=\"w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-lg shadow-indigo-600/25 cursor-pointer\"\n          >\n            {isLoading ? (\n              <>\n                <div className=\"w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                <span>{statusStep || t(\'import.github_importing_btn\')}</span>\n              </>\n            ) : (\n              <>\n                <Github className=\"w-4 h-4\" />\n                <span>{t(\'import.github_import_btn\')}</span>\n                <ArrowRight className=\"w-3.5 h-3.5 ml-1\" />\n              </>\n            )}\n          </button>\n        </form>\n      </div>\n\n      {/* Popular Starters Quick Selector */}\n      <div className=\"p-5 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm\">\n        <div className=\"flex items-center justify-between mb-3\">\n          <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center gap-1.5\">\n            <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span>{t(\'import.github_starters_title\')}</span>\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n          {POPULAR_GITHUB_STARTERS.map((starter) => (\n            <button\n              key={starter.name}\n              type=\"button\"\n              onClick={() => handleSelectStarter(starter)}\n              className=\"p-3 rounded-2xl bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800/80 hover:border-indigo-500/40 text-left transition-all group flex flex-col justify-between\"\n            >\n              <div className=\"flex items-start justify-between w-full gap-2\">\n                <div className=\"font-semibold text-xs text-white group-hover:text-indigo-300 transition-colors truncate\">\n                  {starter.name}\n                </div>\n                <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 shrink-0\">\n                  {starter.category}\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-400 mt-1 line-clamp-2 leading-relaxed\">\n                {starter.desc}\n              </p>\n              <div className=\"mt-2 pt-2 border-t border-slate-800/60 flex items-center justify-between text-[10px] text-slate-500 font-mono\">\n                <span className=\"truncate\">{starter.repo}</span>\n                <span className=\"flex items-center gap-0.5 text-amber-400/90 shrink-0\">\n                  <Star className=\"w-2.5 h-2.5 fill-amber-400/90\" /> {starter.stars}\n                </span>\n              </div>\n            </button>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        replacement_content: "import React, { useState, useEffect, useMemo, useCallback } from \'react\';\nimport {\n  Github,\n  GitBranch,\n  FolderTree,\n  KeyRound,\n  ArrowRight,\n  Sparkles,\n  AlertCircle,\n  CheckCircle2,\n  Lock,\n  Star,\n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n  Search,\n  LogOut,\n  Globe,\n  RefreshCw,\n  Eye,\n  EyeOff,\n  Copy,\n  Check,\n  ShieldCheck,\n} from \'lucide-react\';\nimport {\n  fetchGitHubRepo,\n  fetchGitHubUserRepos,\n  checkGitHubOAuthConfig,\n  POPULAR_GITHUB_STARTERS,\n  GitHubQuickTemplate,\n  GitHubUserProfile,\n  GitHubUserRepoItem,\n} from \'../utils/github\';\nimport { ProjectData } from \'../types\';\nimport { useI18n } from \'../i18n/context\';\n\ninterface GitHubImportCardProps {\n  onImportProject: (project: ProjectData) => void;\n  onShowToast?: (msg: string, type: \'success\' | \'error\' | \'info\' | \'warn\') => void;\n}\n\ntype AuthMode = \'oauth\' | \'pat\' | \'url\';\n\nexport const GitHubImportCard: React.FC<GitHubImportCardProps> = ({\n  onImportProject,\n  onShowToast,\n}) => {\n  const { t } = useI18n();\n\n  // Auth State\n  const [token, setToken] = useState<string>(() => {\n    try {\n      return localStorage.getItem(\'godeploy_github_pat\') || \'\';\n    } catch {\n      return \'\';\n    }\n  });\n  const [authType, setAuthType] = useState<\'oauth\' | \'pat\' | null>(() => {\n    try {\n      return (localStorage.getItem(\'godeploy_github_authtype\') as any) || (localStorage.getItem(\'godeploy_github_pat\') ? \'pat\' : null);\n    } catch {\n      return null;\n    }\n  });\n  const [userProfile, setUserProfile] = useState<GitHubUserProfile | null>(() => {\n    try {\n      const saved = localStorage.getItem(\'godeploy_github_user\');\n      return saved ? JSON.parse(saved) : null;\n    } catch {\n      return null;\n    }\n  });\n\n  // Repositories List\n  const [userRepos, setUserRepos] = useState<GitHubUserRepoItem[]>([]);\n  const [isLoadingRepos, setIsLoadingRepos] = useState(false);\n  const [repoFilter, setRepoFilter] = useState<\'all\' | \'private\' | \'public\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  // OAuth Config State\n  const [oAuthConfig, setOAuthConfig] = useState<{\n    configured: boolean;\n    url: string | null;\n    redirectUri: string;\n    clientId: string | null;\n  } | null>(null);\n  const [showOAuthHelp, setShowOAuthHelp] = useState(false);\n  const [copiedCallback, setCopiedCallback] = useState(false);\n\n  // Manual URL Form State\n  const [repoInput, setRepoInput] = useState(\'\');\n  const [branch, setBranch] = useState(\'\');\n  const [subpath, setSubpath] = useState(\'\');\n  const [showAdvanced, setShowAdvanced] = useState(false);\n  const [showPatInput, setShowPatInput] = useState(false);\n  const [patInputVal, setPatInputVal] = useState(\'\');\n  const [showPatPassword, setShowPatPassword] = useState(false);\n  const [isConnectingPat, setIsConnectingPat] = useState(false);\n\n  // Import Action State\n  const [isLoading, setIsLoading] = useState(false);\n  const [importingRepoName, setImportingRepoName] = useState<string | null>(null);\n  const [statusStep, setStatusStep] = useState<string>(\'\');\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  // Check OAuth configuration on load\n  useEffect(() => {\n    checkGitHubOAuthConfig().then((cfg) => {\n      setOAuthConfig(cfg);\n    });\n  }, []);\n\n  // Fetch repositories whenever token is present\n  const loadUserRepositories = useCallback(async (authToken: string) => {\n    if (!authToken.trim()) return;\n    setIsLoadingRepos(true);\n    setErrorMsg(null);\n    try {\n      const { user, repos } = await fetchGitHubUserRepos(authToken.trim());\n      setUserProfile(user);\n      setUserRepos(repos);\n      try {\n        localStorage.setItem(\'godeploy_github_user\', JSON.stringify(user));\n      } catch {\n        // ignore\n      }\n    } catch (err: any) {\n      console.warn(\'Failed to load GitHub user repos:\', err);\n      // If 401, clear stale credentials\n      if (err.message && err.message.includes(\'expired\')) {\n        handleDisconnect();\n      }\n    } finally {\n      setIsLoadingRepos(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    if (token) {\n      loadUserRepositories(token);\n    }\n  }, [token, loadUserRepositories]);\n\n  // Listen for OAuth Popup Message\n  useEffect(() => {\n    const handleOAuthMessage = (event: MessageEvent) => {\n      const origin = event.origin;\n      // Allow localhost and cloud run origins\n      if (!origin.endsWith(\'.run.app\') && !origin.includes(\'localhost\')) {\n        return;\n      }\n\n      if (event.data?.type === \'GITHUB_OAUTH_SUCCESS\') {\n        const receivedToken = event.data.token;\n        const user = event.data.user;\n        if (receivedToken) {\n          setToken(receivedToken);\n          setAuthType(\'oauth\');\n          setUserProfile(user);\n          try {\n            localStorage.setItem(\'godeploy_github_pat\', receivedToken);\n            localStorage.setItem(\'godeploy_github_authtype\', \'oauth\');\n            if (user) {\n              localStorage.setItem(\'godeploy_github_user\', JSON.stringify(user));\n            }\n          } catch {\n            // ignore\n          }\n\n          if (onShowToast) {\n            onShowToast(`Connected as @${user?.login || \'GitHub User\'} via OAuth!`, \'success\');\n          }\n          loadUserRepositories(receivedToken);\n        }\n      } else if (event.data?.type === \'GITHUB_OAUTH_ERROR\') {\n        const msg = event.data.error || \'GitHub authentication failed\';\n        setErrorMsg(msg);\n        if (onShowToast) {\n          onShowToast(msg, \'error\');\n        }\n      }\n    };\n\n    window.addEventListener(\'message\', handleOAuthMessage);\n    return () => window.removeEventListener(\'message\', handleOAuthMessage);\n  }, [loadUserRepositories, onShowToast]);\n\n  // OAuth Popup Trigger\n  const handleConnectOAuth = async () => {\n    setErrorMsg(null);\n    try {\n      const cfg = oAuthConfig || (await checkGitHubOAuthConfig());\n      setOAuthConfig(cfg);\n\n      if (!cfg.configured || !cfg.url) {\n        setShowOAuthHelp(true);\n        if (onShowToast) {\n          onShowToast(\'GitHub OAuth App is not configured. See setup guide or use Personal Access Token.\', \'info\');\n        }\n        return;\n      }\n\n      // Open OAuth provider URL directly in popup\n      const width = 620;\n      const height = 750;\n      const left = window.screenX + (window.outerWidth - width) / 2;\n      const top = window.screenY + (window.outerHeight - height) / 2;\n\n      const authWindow = window.open(\n        cfg.url,\n        \'github_oauth_popup\',\n        `width=${width},height=${height},left=${left},top=${top},status=no,resizable=yes,scrollbars=yes`\n      );\n\n      if (!authWindow) {\n        alert(\'Please allow popups to connect your GitHub account.\');\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Failed to initiate GitHub OAuth\');\n    }\n  };\n\n  // Connect via Personal Access Token\n  const handleConnectPAT = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!patInputVal.trim()) return;\n\n    setIsConnectingPat(true);\n    setErrorMsg(null);\n    try {\n      const { user, repos } = await fetchGitHubUserRepos(patInputVal.trim());\n      setToken(patInputVal.trim());\n      setAuthType(\'pat\');\n      setUserProfile(user);\n      setUserRepos(repos);\n      try {\n        localStorage.setItem(\'godeploy_github_pat\', patInputVal.trim());\n        localStorage.setItem(\'godeploy_github_authtype\', \'pat\');\n        localStorage.setItem(\'godeploy_github_user\', JSON.stringify(user));\n      } catch {\n        // ignore\n      }\n\n      setPatInputVal(\'\');\n      setShowPatInput(false);\n      if (onShowToast) {\n        onShowToast(`Connected to GitHub as @${user.login} (${repos.length} repos loaded)`, \'success\');\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Invalid GitHub token. Please verify token permissions.\');\n      if (onShowToast) {\n        onShowToast(err.message || \'Token validation failed\', \'error\');\n      }\n    } finally {\n      setIsConnectingPat(false);\n    }\n  };\n\n  // Disconnect GitHub\n  const handleDisconnect = () => {\n    setToken(\'\');\n    setAuthType(null);\n    setUserProfile(null);\n    setUserRepos([]);\n    try {\n      localStorage.removeItem(\'godeploy_github_pat\');\n      localStorage.removeItem(\'godeploy_github_authtype\');\n      localStorage.removeItem(\'godeploy_github_user\');\n    } catch {\n      // ignore\n    }\n    if (onShowToast) {\n      onShowToast(\'Disconnected GitHub account.\', \'info\');\n    }\n  };\n\n  // Manual Import Action\n  const handleImport = async (e?: React.FormEvent, customRepo?: string, customBranch?: string) => {\n    if (e) e.preventDefault();\n    const targetRepo = customRepo || repoInput.trim();\n    if (!targetRepo) return;\n\n    setErrorMsg(null);\n    setIsLoading(true);\n    setImportingRepoName(targetRepo);\n    setStatusStep(\'Connecting to GitHub...\');\n\n    try {\n      const result = await fetchGitHubRepo(targetRepo, {\n        branch: customBranch || branch.trim() || undefined,\n        subpath: subpath.trim() || undefined,\n        token: token.trim() || undefined,\n        onProgress: (step) => setStatusStep(step),\n      });\n\n      if (onShowToast) {\n        onShowToast(\n          `Successfully pulled ${result.details.fullName} (${result.project.fileCount} files)`,\n          \'success\'\n        );\n      }\n\n      onImportProject(result.project);\n    } catch (err: any) {\n      const msg = err.message || \'Failed to import repository from GitHub\';\n      setErrorMsg(msg);\n      if (onShowToast) {\n        onShowToast(msg, \'error\');\n      }\n    } finally {\n      setIsLoading(false);\n      setImportingRepoName(null);\n      setStatusStep(\'\');\n    }\n  };\n\n  const handleSelectStarter = (starter: GitHubQuickTemplate) => {\n    setRepoInput(starter.repo);\n    setBranch(starter.branch || \'\');\n    setSubpath(starter.subpath || \'\');\n    setShowAdvanced(Boolean(starter.branch || starter.subpath));\n  };\n\n  const copyCallbackUrl = () => {\n    const cb = oAuthConfig?.redirectUri || `${window.location.origin}/auth/github/callback`;\n    navigator.clipboard.writeText(cb);\n    setCopiedCallback(true);\n    setTimeout(() => setCopiedCallback(false), 2000);\n  };\n\n  // Filtered repositories list\n  const filteredRepos = useMemo(() => {\n    return userRepos.filter((repo) => {\n      if (repoFilter === \'private\' && !repo.private) return false;\n      if (repoFilter === \'public\' && repo.private) return false;\n      if (searchQuery.trim()) {\n        const q = searchQuery.toLowerCase();\n        return (\n          repo.name.toLowerCase().includes(q) ||\n          repo.full_name.toLowerCase().includes(q) ||\n          (repo.description && repo.description.toLowerCase().includes(q))\n        );\n      }\n      return true;\n    });\n  }, [userRepos, repoFilter, searchQuery]);\n\n  const privateReposCount = useMemo(() => userRepos.filter((r) => r.private).length, [userRepos]);\n  const publicReposCount = useMemo(() => userRepos.filter((r) => !r.private).length, [userRepos]);\n\n  return (\n    <div className=\"space-y-4\">\n      {/* 1. Top Authentication Status / Connection Header Card */}\n      <div className=\"p-5 rounded-3xl bg-slate-900/70 backdrop-blur-md border border-slate-800 shadow-sm relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 w-44 h-44 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none\" />\n\n        {userProfile && token ? (\n          /* Logged In State */\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center justify-between flex-wrap gap-3\">\n              <div className=\"flex items-center gap-3\">\n                <img\n                  src={userProfile.avatar_url || \'https://github.com/github.png\'}\n                  alt={userProfile.login}\n                  className=\"w-10 h-10 rounded-full border-2 border-indigo-500/50 object-cover\"\n                />\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"font-bold text-sm text-white\">\n                      {userProfile.name || userProfile.login}\n                    </span>\n                    <span className=\"text-xs text-slate-400 font-mono\">@{userProfile.login}</span>\n                    <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                      <ShieldCheck className=\"w-3 h-3\" />\n                      {authType === \'oauth\' ? \'OAuth Connected\' : \'PAT Authenticated\'}\n                    </span>\n                  </div>\n                  <div className=\"text-[11px] text-slate-400 flex items-center gap-3 mt-0.5\">\n                    <span className=\"flex items-center gap-1 text-indigo-300\">\n                      <Lock className=\"w-3 h-3 text-amber-400\" /> Private repos unlocked\n                    </span>\n                    <span>\342\200\242</span>\n                    <span>{userRepos.length} repos available</span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => loadUserRepositories(token)}\n                  disabled={isLoadingRepos}\n                  title=\"Refresh Repositories\"\n                  className=\"p-2 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 text-slate-300 hover:text-white transition-colors cursor-pointer\"\n                >\n                  <RefreshCw className={`w-3.5 h-3.5 ${isLoadingRepos ? \'animate-spin\' : \'\'}`} />\n                </button>\n                <button\n                  onClick={handleDisconnect}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-950/80 hover:bg-rose-950/40 border border-slate-800 hover:border-rose-700/50 text-slate-300 hover:text-rose-300 transition-colors cursor-pointer\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                  <span>Disconnect</span>\n                </button>\n              </div>\n            </div>\n          </div>\n        ) : (\n          /* Unauthenticated State: Offer 1-Click OAuth or PAT */\n          <div className=\"space-y-3.5\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <Github className=\"w-5 h-5 text-white\" />\n                <h2 className=\"text-sm font-bold text-white\">GitHub Account Connection</h2>\n              </div>\n              <span className=\"text-[11px] font-mono text-slate-400 bg-slate-950/80 border border-slate-800 px-2.5 py-0.5 rounded-full flex items-center gap-1\">\n                <Lock className=\"w-3 h-3 text-amber-400\" /> Private Repos Support\n              </span>\n            </div>\n\n            <p className=\"text-xs text-slate-400 leading-relaxed\">\n              Connect your GitHub account with <strong>1-Click OAuth</strong> or enter a <strong>Personal Access Token (PAT)</strong> to import private repositories, view your repo list, and eliminate API rate limits.\n            </p>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1\">\n              {/* 1-Click OAuth Button */}\n              <button\n                type=\"button\"\n                onClick={handleConnectOAuth}\n                className=\"flex items-center justify-center gap-2.5 py-2.5 px-4 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all shadow-md shadow-indigo-600/20 cursor-pointer group\"\n              >\n                <Github className=\"w-4 h-4 group-hover:scale-110 transition-transform\" />\n                <span>Connect with GitHub (OAuth)</span>\n              </button>\n\n              {/* Personal Access Token Button */}\n              <button\n                type=\"button\"\n                onClick={() => setShowPatInput(!showPatInput)}\n                className=\"flex items-center justify-center gap-2 py-2.5 px-4 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 text-slate-200 text-xs font-semibold transition-all cursor-pointer\"\n              >\n                <KeyRound className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span>{showPatInput ? \'Hide PAT Input\' : \'Use Personal Access Token\'}</span>\n              </button>\n            </div>\n\n            {/* PAT Expandable Box */}\n            {showPatInput && (\n              <form onSubmit={handleConnectPAT} className=\"p-4 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-3 animate-in fade-in duration-200\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <span className=\"font-semibold text-slate-200 flex items-center gap-1.5\">\n                    <KeyRound className=\"w-3.5 h-3.5 text-amber-400\" />\n                    Enter GitHub Personal Access Token\n                  </span>\n                  <a\n                    href=\"https://github.com/settings/tokens/new?scopes=repo,read:user&description=GoDeploy+Hostinger+Converter\"\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    className=\"text-[11px] text-indigo-400 hover:text-indigo-300 flex items-center gap-1 underline underline-offset-2\"\n                  >\n                    <span>Generate Token on GitHub</span>\n                    <ExternalLink className=\"w-3 h-3\" />\n                  </a>\n                </div>\n\n                <div className=\"relative\">\n                  <input\n                    type={showPatPassword ? \'text\' : \'password\'}\n                    value={patInputVal}\n                    onChange={(e) => setPatInputVal(e.target.value)}\n                    placeholder=\"ghp_xxxxxxxxxxxx or github_pat_xxxxxxxxxxxx\"\n                    className=\"w-full pl-3.5 pr-10 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                    disabled={isConnectingPat}\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowPatPassword(!showPatPassword)}\n                    className=\"absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-white\"\n                  >\n                    {showPatPassword ? <EyeOff className=\"w-3.5 h-3.5\" /> : <Eye className=\"w-3.5 h-3.5\" />}\n                  </button>\n                </div>\n\n                <div className=\"flex items-center justify-between gap-2 pt-1\">\n                  <p className=\"text-[10px] text-slate-500 flex items-center gap-1\">\n                    <Lock className=\"w-3 h-3\" /> Requires <code className=\"text-slate-400\">repo</code> and <code className=\"text-slate-400\">read:user</code> scopes. Saved securely in browser storage.\n                  </p>\n                  <button\n                    type=\"submit\"\n                    disabled={isConnectingPat || !patInputVal.trim()}\n                    className=\"px-4 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-50 transition-colors shrink-0 cursor-pointer\"\n                  >\n                    {isConnectingPat ? \'Verifying...\' : \'Validate & Connect\'}\n                  </button>\n                </div>\n              </form>\n            )}\n\n            {/* OAuth Setup Info / Help Dropdown */}\n            {showOAuthHelp && (\n              <div className=\"p-4 rounded-2xl bg-indigo-950/40 border border-indigo-500/30 text-xs text-slate-300 space-y-2.5 animate-in fade-in duration-200\">\n                <div className=\"flex items-start justify-between\">\n                  <div className=\"font-semibold text-indigo-300 flex items-center gap-1.5\">\n                    <Github className=\"w-4 h-4\" />\n                    GitHub OAuth Setup Instructions\n                  </div>\n                  <button\n                    onClick={() => setShowOAuthHelp(false)}\n                    className=\"text-slate-400 hover:text-white text-xs\"\n                  >\n                    \342\234\225\n                  </button>\n                </div>\n\n                <p className=\"text-[11px] text-slate-300 leading-relaxed\">\n                  To enable 1-Click OAuth sign-in for users, register an OAuth App in GitHub Developer Settings and configure the client credentials in your server environment:\n                </p>\n\n                <div className=\"bg-slate-950 p-2.5 rounded-xl border border-slate-800 space-y-1.5\">\n                  <div className=\"text-[10px] uppercase font-mono text-slate-400\">Required Authorization Callback URL:</div>\n                  <div className=\"flex items-center justify-between gap-2 bg-slate-900 px-2.5 py-1.5 rounded-lg font-mono text-[11px] text-indigo-300 overflow-x-auto\">\n                    <span className=\"truncate\">{oAuthConfig?.redirectUri || `${window.location.origin}/auth/github/callback`}</span>\n                    <button\n                      type=\"button\"\n                      onClick={copyCallbackUrl}\n                      className=\"text-slate-400 hover:text-white p-1 shrink-0 cursor-pointer\"\n                      title=\"Copy callback URL\"\n                    >\n                      {copiedCallback ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"text-[11px] text-slate-400\">\n                  Add <code className=\"text-indigo-300 font-mono\">GITHUB_CLIENT_ID</code> and <code className=\"text-indigo-300 font-mono\">GITHUB_CLIENT_SECRET</code> to your app\'s Settings / Secrets panel. You can also connect immediately using a Personal Access Token above.\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n\n      {/* 2. Repository Explorer (When Authenticated and Repos are loaded) */}\n      {userProfile && token && (\n        <div className=\"p-5 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm space-y-3.5 animate-in fade-in duration-200\">\n          <div className=\"flex items-center justify-between flex-wrap gap-2\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center gap-1.5\">\n              <FolderTree className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>Select from Your Repositories</span>\n            </h3>\n\n            {/* Filter Tabs */}\n            <div className=\"flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800 text-[11px]\">\n              <button\n                type=\"button\"\n                onClick={() => setRepoFilter(\'all\')}\n                className={`px-2.5 py-1 rounded-lg font-medium transition-all ${\n                  repoFilter === \'all\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-white\'\n                }`}\n              >\n                All ({userRepos.length})\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setRepoFilter(\'private\')}\n                className={`px-2.5 py-1 rounded-lg font-medium flex items-center gap-1 transition-all ${\n                  repoFilter === \'private\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-white\'\n                }`}\n              >\n                <Lock className=\"w-2.5 h-2.5 text-amber-400\" />\n                Private ({privateReposCount})\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setRepoFilter(\'public\')}\n                className={`px-2.5 py-1 rounded-lg font-medium flex items-center gap-1 transition-all ${\n                  repoFilter === \'public\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-white\'\n                }`}\n              >\n                <Globe className=\"w-2.5 h-2.5 text-sky-400\" />\n                Public ({publicReposCount})\n              </button>\n            </div>\n          </div>\n\n          {/* Search Box */}\n          <div className=\"relative\">\n            <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Search your repositories by name or description...\"\n              className=\"w-full pl-9 pr-4 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n            />\n          </div>\n\n          {/* Repos Grid / List */}\n          {isLoadingRepos ? (\n            <div className=\"py-8 text-center text-xs text-slate-400 space-y-2\">\n              <div className=\"w-5 h-5 border-2 border-indigo-500 border-t-transparent rounded-full animate-spin mx-auto\" />\n              <div>Fetching your repositories from GitHub API...</div>\n            </div>\n          ) : filteredRepos.length > 0 ? (\n            <div className=\"max-h-72 overflow-y-auto space-y-2 pr-1 custom-scrollbar\">\n              {filteredRepos.map((repo) => {\n                const isThisImporting = isLoading && importingRepoName === repo.full_name;\n                return (\n                  <div\n                    key={repo.id}\n                    className=\"p-3 rounded-2xl bg-slate-950/60 hover:bg-slate-950 border border-slate-800/80 hover:border-indigo-500/50 flex items-center justify-between gap-3 transition-all group\"\n                  >\n                    <div className=\"min-w-0 flex-1\">\n                      <div className=\"flex items-center gap-2\">\n                        {repo.private ? (\n                          <span className=\"p-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20\" title=\"Private Repository\">\n                            <Lock className=\"w-3 h-3\" />\n                          </span>\n                        ) : (\n                          <span className=\"p-1 rounded-md bg-sky-500/10 text-sky-400 border border-sky-500/20\" title=\"Public Repository\">\n                            <Globe className=\"w-3 h-3\" />\n                          </span>\n                        )}\n                        <span className=\"font-semibold text-xs text-white group-hover:text-indigo-300 transition-colors truncate\">\n                          {repo.full_name}\n                        </span>\n                        {repo.language && (\n                          <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400\">\n                            {repo.language}\n                          </span>\n                        )}\n                      </div>\n\n                      {repo.description && (\n                        <p className=\"text-[11px] text-slate-400 mt-1 line-clamp-1\">\n                          {repo.description}\n                        </p>\n                      )}\n\n                      <div className=\"flex items-center gap-3 text-[10px] text-slate-500 font-mono mt-1\">\n                        <span className=\"flex items-center gap-0.5 text-amber-400/90\">\n                          <Star className=\"w-2.5 h-2.5 fill-amber-400/90\" /> {repo.stars}\n                        </span>\n                        <span>Branch: {repo.default_branch}</span>\n                        <span>Updated: {new Date(repo.updated_at).toLocaleDateString()}</span>\n                      </div>\n                    </div>\n\n                    <button\n                      type=\"button\"\n                      disabled={isLoading}\n                      onClick={() => handleImport(undefined, repo.full_name, repo.default_branch)}\n                      className=\"px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-50 transition-all shrink-0 flex items-center gap-1.5 shadow-sm shadow-indigo-600/20 cursor-pointer\"\n                    >\n                      {isThisImporting ? (\n                        <>\n                          <div className=\"w-3 h-3 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                          <span>Importing...</span>\n                        </>\n                      ) : (\n                        <>\n                          <span>Import</span>\n                          <ArrowRight className=\"w-3 h-3\" />\n                        </>\n                      )}\n                    </button>\n                  </div>\n                );\n              })}\n            </div>\n          ) : (\n            <div className=\"py-6 text-center text-xs text-slate-400\">\n              No repositories match your current search/filter.\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* 3. Manual Repository URL / Slug Form */}\n      <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm relative overflow-hidden\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n            <Github className=\"w-4 h-4 text-white\" />\n            <span>Import Any Repository URL / Slug</span>\n          </h2>\n          <span className=\"text-[11px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full flex items-center gap-1\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n            Direct Fetch\n          </span>\n        </div>\n\n        <p className=\"text-xs text-slate-400 mb-4 leading-relaxed\">\n          {t(\'import.github_subtitle\')}\n        </p>\n\n        <form onSubmit={(e) => handleImport(e)} className=\"space-y-3.5\">\n          {/* Main Repo URL Input */}\n          <div>\n            <label className=\"block text-xs font-medium text-slate-300 mb-1.5 flex items-center justify-between\">\n              <span>Repository URL or Slug</span>\n              <span className=\"text-[11px] text-slate-500 font-mono\">e.g. owner/repo or https://github.com/owner/repo</span>\n            </label>\n            <div className=\"relative\">\n              <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500\">\n                <Github className=\"w-4 h-4\" />\n              </div>\n              <input\n                type=\"text\"\n                value={repoInput}\n                onChange={(e) => {\n                  setRepoInput(e.target.value);\n                  if (errorMsg) setErrorMsg(null);\n                }}\n                placeholder={t(\'import.github_placeholder\')}\n                className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 font-mono transition-all\"\n                disabled={isLoading}\n              />\n            </div>\n          </div>\n\n          {/* Advanced options accordion toggle */}\n          <div className=\"pt-1\">\n            <button\n              type=\"button\"\n              onClick={() => setShowAdvanced(!showAdvanced)}\n              className=\"text-xs text-indigo-400 hover:text-indigo-300 font-medium flex items-center gap-1 transition-colors cursor-pointer\"\n            >\n              <span>{showAdvanced ? \'Hide branch & subfolder options\' : \'Configure custom branch, subfolder, or token\'}</span>\n              {showAdvanced ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n            </button>\n\n            {showAdvanced && (\n              <div className=\"mt-3 p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 space-y-3 animate-in fade-in slide-in-from-top-1 duration-200\">\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  {/* Branch Input */}\n                  <div>\n                    <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5\">\n                      <GitBranch className=\"w-3.5 h-3.5 text-indigo-400\" />\n                      <span>{t(\'import.github_branch\')}</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={branch}\n                      onChange={(e) => setBranch(e.target.value)}\n                      placeholder=\"e.g. main, dev, or v1.0\"\n                      className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                      disabled={isLoading}\n                    />\n                  </div>\n\n                  {/* Subfolder Input */}\n                  <div>\n                    <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5\">\n                      <FolderTree className=\"w-3.5 h-3.5 text-indigo-400\" />\n                      <span>{t(\'import.github_subpath\')}</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={subpath}\n                      onChange={(e) => setSubpath(e.target.value)}\n                      placeholder=\"e.g. client, frontend, apps/web\"\n                      className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                      disabled={isLoading}\n                    />\n                  </div>\n                </div>\n\n                {/* Token override if not already connected */}\n                {!userProfile && (\n                  <div>\n                    <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center justify-between\">\n                      <span className=\"flex items-center gap-1.5\">\n                        <KeyRound className=\"w-3.5 h-3.5 text-amber-400\" />\n                        <span>{t(\'import.github_token\')}</span>\n                      </span>\n                      <span className=\"text-[10px] text-slate-500 flex items-center gap-1\">\n                        <Lock className=\"w-3 h-3\" /> Optional for public repos\n                      </span>\n                    </label>\n                    <input\n                      type=\"password\"\n                      value={token}\n                      onChange={(e) => {\n                        const val = e.target.value;\n                        setToken(val);\n                        try {\n                          if (val.trim()) {\n                            localStorage.setItem(\'godeploy_github_pat\', val.trim());\n                          } else {\n                            localStorage.removeItem(\'godeploy_github_pat\');\n                          }\n                        } catch {\n                          // ignore\n                        }\n                      }}\n                      placeholder=\"ghp_xxxxxxxxxxxxxxxxxxxx (Optional)\"\n                      className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                      disabled={isLoading}\n                    />\n                  </div>\n                )}\n              </div>\n            )}\n          </div>\n\n          {/* Error Message Box */}\n          {errorMsg && (\n            <div className=\"p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs flex items-start gap-2 animate-in fade-in duration-150\">\n              <AlertCircle className=\"w-4 h-4 text-rose-400 shrink-0 mt-0.5\" />\n              <div className=\"leading-normal\">\n                <span className=\"font-semibold\">GitHub Import Error: </span>\n                {errorMsg}\n              </div>\n            </div>\n          )}\n\n          {/* Submit Button */}\n          <button\n            type=\"submit\"\n            disabled={isLoading || !repoInput.trim()}\n            className=\"w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-lg shadow-indigo-600/25 cursor-pointer\"\n          >\n            {isLoading && !importingRepoName ? (\n              <>\n                <div className=\"w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                <span>{statusStep || t(\'import.github_importing_btn\')}</span>\n              </>\n            ) : (\n              <>\n                <Github className=\"w-4 h-4\" />\n                <span>{t(\'import.github_import_btn\')}</span>\n                <ArrowRight className=\"w-3.5 h-3.5 ml-1\" />\n              </>\n            )}\n          </button>\n        </form>\n      </div>\n\n      {/* 4. Popular Starters Quick Selector */}\n      <div className=\"p-5 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm\">\n        <div className=\"flex items-center justify-between mb-3\">\n          <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center gap-1.5\">\n            <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span>{t(\'import.github_starters_title\')}</span>\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n          {POPULAR_GITHUB_STARTERS.map((starter) => (\n            <button\n              key={starter.name}\n              type=\"button\"\n              onClick={() => handleSelectStarter(starter)}\n              className=\"p-3 rounded-2xl bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800/80 hover:border-indigo-500/40 text-left transition-all group flex flex-col justify-between cursor-pointer\"\n            >\n              <div className=\"flex items-start justify-between w-full gap-2\">\n                <div className=\"font-semibold text-xs text-white group-hover:text-indigo-300 transition-colors truncate\">\n                  {starter.name}\n                </div>\n                <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 shrink-0\">\n                  {starter.category}\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-400 mt-1 line-clamp-2 leading-relaxed\">\n                {starter.desc}\n              </p>\n              <div className=\"mt-2 pt-2 border-t border-slate-800/60 flex items-center justify-between text-[10px] text-slate-500 font-mono\">\n                <span className=\"truncate\">{starter.repo}</span>\n                <span className=\"flex items-center gap-0.5 text-amber-400/90 shrink-0\">\n                  <Star className=\"w-2.5 h-2.5 fill-amber-400/90\" /> {starter.stars}\n                </span>\n              </div>\n            </button>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
