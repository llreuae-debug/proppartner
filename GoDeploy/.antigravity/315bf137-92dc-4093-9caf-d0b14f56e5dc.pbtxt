    instruction: "Use generateConversionReportHtml in handleDownloadReport in App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "  // Download Conversion Report HTML\n  const handleDownloadReport = async () => {\n    if (!project || !analysis) return;\n    try {\n      const { buildHostingerPackage } = await import(\'./utils/packager\');\n      // We can generate report from packager internal or create blob\n      const htmlContent = `<!DOCTYPE html><html><head><title>${project.name} - Report</title></head><body><h1>GoDeploy Report for ${project.name}</h1></body></html>`;\n      const blob = new Blob([htmlContent], { type: \'text/html\' });\n      const url = URL.createObjectURL(blob);\n      const link = document.createElement(\'a\');\n      link.href = url;\n      link.download = \'conversion-report.html\';\n      document.body.appendChild(link);\n      link.click();\n      link.remove();\n      setTimeout(() => URL.revokeObjectURL(url), 1000);\n      addToast(\'Report downloaded\', \'success\');\n    } catch {\n      // ignore\n    }\n  };"
        replacement_content: "  // Download Conversion Report HTML\n  const handleDownloadReport = async () => {\n    if (!project || !analysis) return;\n    try {\n      const { generateConversionReportHtml } = await import(\'./utils/packager\');\n      const htmlContent = generateConversionReportHtml(\n        project,\n        analysis,\n        fixes,\n        packageBlob?.mode || buildMode\n      );\n      const blob = new Blob([htmlContent], { type: \'text/html;charset=utf-8\' });\n      const url = URL.createObjectURL(blob);\n      const link = document.createElement(\'a\');\n      link.href = url;\n      link.download = `${project.name}-godeploy-report.html`;\n      document.body.appendChild(link);\n      link.click();\n      link.remove();\n      setTimeout(() => URL.revokeObjectURL(url), 1000);\n      addToast(\'Detailed conversion report downloaded\', \'success\');\n    } catch (err: any) {\n      addToast(`Failed to generate report: ${err.message}`, \'error\');\n    }\n  };"
      }
      num_matches: 1
    }
  }
}
