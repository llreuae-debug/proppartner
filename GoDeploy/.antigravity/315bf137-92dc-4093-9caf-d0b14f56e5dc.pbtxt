        target_content: "import { ProjectData, ProjectFilesMap } from \'../types\';\n\nexport interface GitHubUserProfile {\n  login: string;\n  name: string;\n  avatar_url: string;\n  html_url: string;\n  total_private_repos?: number;\n  public_repos?: number;\n}\n\nexport interface GitHubUserRepoItem {\n  id: number;\n  name: string;\n  full_name: string;\n  owner: string;\n  private: boolean;\n  description: string;\n  default_branch: string;\n  stars: number;\n  forks: number;\n  language: string;\n  updated_at: string;\n  html_url: string;\n}\n\nexport async function checkGitHubOAuthConfig(): Promise<{\n  configured: boolean;\n  url: string | null;\n  redirectUri: string;\n  clientId: string | null;\n}> {\n  try {\n    const res = await fetch(\'/api/auth/github/url\');\n    if (res.ok) {\n      const data = await res.json();\n      return {\n        configured: Boolean(data.configured),\n        url: data.url || null,\n        redirectUri: data.redirectUri || `${window.location.origin}/auth/github/callback`,\n        clientId: data.clientId || null,\n      };\n    }\n  } catch {\n    // fallback\n  }\n  return {\n    configured: false,\n    url: null,\n    redirectUri: `${window.location.origin}/auth/github/callback`,\n    clientId: null,\n  };\n}\n\nexport async function fetchGitHubUserRepos(token: string): Promise<{\n  user: GitHubUserProfile;\n  repos: GitHubUserRepoItem[];\n}> {\n  if (!token || !token.trim()) {\n    throw new Error(\'Please provide a valid GitHub authentication token.\');\n  }\n\n  // Try server proxy first\n  try {\n    const res = await fetch(\'/api/github/user-repos\', {\n      method: \'POST\',\n      headers: {\n        \'Content-Type\': \'application/json\',\n        Authorization: `Bearer ${token.trim()}`,\n      },\n      body: JSON.stringify({ token: token.trim() }),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data.success) {\n        return {\n          user: data.user,\n          repos: data.repos || [],\n        };\n      }\n    } else {\n      const errData = await res.json().catch(() => ({}));\n      if (errData.error) {\n        throw new Error(errData.error);\n      }\n    }\n  } catch (err: any) {\n    if (err.message && !err.message.includes(\'fetch\')) {\n      throw err;\n    }\n  }\n\n  // Client-side fallback direct to api.github.com\n  const headers = {\n    Authorization: `Bearer ${token.trim()}`,\n    Accept: \'application/vnd.github.v3+json\',\n  };\n\n  const userRes = await fetch(\'https://api.github.com/user\', { headers });\n  if (!userRes.ok) {\n    if (userRes.status === 401) {\n      throw new Error(\'Invalid or expired GitHub token. Please verify permissions.\');\n    }\n    throw new Error(`GitHub user error: ${userRes.statusText}`);\n  }\n  const user = await userRes.json();\n\n  const reposRes = await fetch(\n    \'https://api.github.com/user/repos?sort=updated&per_page=100&affiliation=owner,collaborator,organization_member\',\n    { headers }\n  );\n\n  let repos: GitHubUserRepoItem[] = [];\n  if (reposRes.ok) {\n    const rawRepos = await reposRes.json();\n    repos = rawRepos.map((r: any) => ({\n      id: r.id,\n      name: r.name,\n      full_name: r.full_name,\n      owner: r.owner?.login || \'\',\n      private: Boolean(r.private),\n      description: r.description || \'\',\n      default_branch: r.default_branch || \'main\',\n      stars: r.stargazers_count || 0,\n      forks: r.forks_count || 0,\n      language: r.language || \'\',\n      updated_at: r.updated_at,\n      html_url: r.html_url,\n    }));\n  }\n\n  return {\n    user: {\n      login: user.login,\n      name: user.name || user.login,\n      avatar_url: user.avatar_url,\n      html_url: user.html_url,\n      total_private_repos: user.total_private_repos || 0,\n      public_repos: user.public_repos || 0,\n    },\n    repos,\n  };\n}\n\nexport interface GitHubRepoDetails {"
