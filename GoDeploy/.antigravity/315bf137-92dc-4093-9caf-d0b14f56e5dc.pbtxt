      target_content: "export const ToastContainer: React.FC<ToastContainerProps> = ({ toasts, onDismiss }) => {\n  return (\n    <div className=\"fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full\">\n      {toasts.map((t) => {\n        return (\n          <div\n            key={t.id}\n            className={`pointer-events-auto flex items-start gap-3 p-3.5 rounded-xl border shadow-xl backdrop-blur-lg animate-in slide-in-from-right-8 duration-200 transition-all ${\n              t.type === \'success\'\n                ? \'bg-[#121c16]/95 border-[#3ddc8c]/30 text-white\'\n                : t.type === \'warn\'\n                ? \'bg-[#201a0e]/95 border-[#ffb547]/30 text-white\'\n                : t.type === \'error\'\n                ? \'bg-[#201014]/95 border-[#ff5d6c]/30 text-white\'\n                : \'bg-[#121422]/95 border-[#5b8cff]/30 text-white\'\n            }`}\n          >\n            {t.type === \'success\' && <CheckCircle2 className=\"w-4 h-4 text-[#3ddc8c] shrink-0 mt-0.5\" />}\n            {t.type === \'warn\' && <AlertTriangle className=\"w-4 h-4 text-[#ffb547] shrink-0 mt-0.5\" />}\n            {t.type === \'error\' && <AlertCircle className=\"w-4 h-4 text-[#ff5d6c] shrink-0 mt-0.5\" />}\n            {t.type === \'info\' && <Info className=\"w-4 h-4 text-[#5b8cff] shrink-0 mt-0.5\" />}\n\n            <div className=\"text-xs leading-relaxed flex-1 font-medium\">{t.text}</div>\n\n            <button\n              onClick={() => onDismiss(t.id)}\n              className=\"text-white/40 hover:text-white transition-colors -mr-1 -mt-1 p-1\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        );\n      })}\n    </div>\n  );\n};"
      replacement_content: "export const ToastContainer: React.FC<ToastContainerProps> = ({ toasts, onDismiss }) => {\n  return (\n    <div className=\"fixed bottom-5 right-5 z-50 flex flex-col gap-2.5 pointer-events-none max-w-sm w-full\">\n      {toasts.map((t) => {\n        return (\n          <div\n            key={t.id}\n            className={`pointer-events-auto flex items-start gap-3 p-4 rounded-2xl border shadow-2xl backdrop-blur-xl animate-in slide-in-from-right-8 duration-200 transition-all ${\n              t.type === \'success\'\n                ? \'bg-slate-900/95 border-emerald-500/40 text-slate-100 shadow-emerald-500/5\'\n                : t.type === \'warn\'\n                ? \'bg-slate-900/95 border-amber-500/40 text-slate-100 shadow-amber-500/5\'\n                : t.type === \'error\'\n                ? \'bg-slate-900/95 border-rose-500/40 text-slate-100 shadow-rose-500/5\'\n                : \'bg-slate-900/95 border-indigo-500/40 text-slate-100 shadow-indigo-500/5\'\n            }`}\n          >\n            {t.type === \'success\' && <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />}\n            {t.type === \'warn\' && <AlertTriangle className=\"w-4 h-4 text-amber-400 shrink-0 mt-0.5\" />}\n            {t.type === \'error\' && <AlertCircle className=\"w-4 h-4 text-rose-400 shrink-0 mt-0.5\" />}\n            {t.type === \'info\' && <Info className=\"w-4 h-4 text-indigo-400 shrink-0 mt-0.5\" />}\n\n            <div className=\"text-xs leading-relaxed flex-1 font-medium\">{t.text}</div>\n\n            <button\n              onClick={() => onDismiss(t.id)}\n              className=\"text-slate-400 hover:text-white transition-colors -mr-1 -mt-1 p-1\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        );\n      })}\n    </div>\n  );\n};"
