           <button\n              onClick={() => setDevice(\'desktop\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                device === \'desktop\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Monitor className=\"w-3.5 h-3.5\" />\n              <span>Desktop</span>\n            </button>\n\n            <button\n              onClick={() => setDevice(\'tablet\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                device === \'tablet\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Tablet className=\"w-3.5 h-3.5\" />\n              <span>Tablet (768px)</span>\n            </button>\n\n            <button\n              onClick={() => setDevice(\'mobile\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                device === \'mobile\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Smartphone className=\"w-3.5 h-3.5\" />\n              <span>Mobile (375px)</span>\n            </button>\n          </div>\n\n          {/* Simulated URL Bar */}\n          <div className=\"flex-1 min-w-[200px] flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-mono text-slate-400\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400 shrink-0\" />\n            <span className=\"text-emerald-400 font-semibold\">https://</span>\n            <span className=\"text-slate-200 truncate\">your-domain.hostingerapp.com/</span>\n          </div>\n\n          {/* Refresh Button */}\n          <button\n            onClick={() => setRefreshKey((k) => k + 1)}\n            className=\"w-8 h-8 rounded-xl flex items-center justify-center text-slate-400 hover:text-white bg-slate-800/80 hover:bg-slate-700/80 transition-colors shrink-0 border border-slate-700/50\"\n            title=\"Reload Preview\"\n          >\n            <RotateCw className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {/* Viewport Sandbox Canvas */}\n        <div className=\"p-4 bg-slate-950 flex items-center justify-center min-h-[520px] overflow-auto\">\n          <div\n            className=\"bg-white rounded-2xl shadow-2xl overflow-hidden transition-all duration-300 border border-slate-800\"\n            style={{\n              width: device === \'desktop\' ? \'100%\' : device === \'tablet\' ? \'768px\' : \'375px\',\n              height: \'520px\',\n            }}\n          >\n            <iframe\n              key={refreshKey}\n              title=\"Hostinger Deployment Live Preview\"\n              srcDoc={srcDocContent}\n              sandbox=\"allow-scripts allow-same-origin\"\n              className=\"w-full h-full border-0 bg-white\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Simulator Notes Bento Card */}\n      <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm\">\n        <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono mb-2 flex items-center gap-2\">\n          <Layers className=\"w-3.5 h-3.5 text-indigo-400\" />\n          Production Simulation Notes\n        </h3>\n        <ul className=\"text-xs text-slate-400 space-y-1.5 list-disc list-inside leading-relaxed\">\n          <li>Renders verified HTML, linked inlined CSS stylesheets, and normalized asset paths.</li>\n          <li>For full backend database queries or server APIs (Node/Express), deploy the package on Hostinger to execute server code.<