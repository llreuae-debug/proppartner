    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Wrench,\n  CheckCircle2,\n  AlertTriangle,\n  Info,\n  Sparkles,\n  ArrowRight,\n  ArrowLeft,\n  FileCode,\n  Check,\n  ShieldCheck,\n} from \'lucide-react\';\nimport { AppliedFix, ProjectData } from \'../../types\';\n\ninterface RepairViewProps {\n  project: ProjectData;\n  fixes: AppliedFix[];\n  onRunDeepAiRepair: () => void;\n  isAiRepairing: boolean;\n  onNext: () => void;\n  onPrev: () => void;\n}\n\nexport const RepairView: React.FC<RepairViewProps> = ({\n  project,\n  fixes,\n  onRunDeepAiRepair,\n  isAiRepairing,\n  onNext,\n  onPrev,\n}) => {\n  const [activeCategory, setActiveCategory] = useState<string>(\'all\');\n  const [expandedFixId, setExpandedFixId] = useState<string | null>(fixes[0]?.id || null);\n\n  const fixCount = fixes.filter((f) => f.type === \'fix\').length;\n  const warnCount = fixes.filter((f) => f.type === \'warn\').length;\n  const infoCount = fixes.filter((f) => f.type === \'info\').length;\n\n  const categories = [\n    { id: \'all\', label: `All (${fixes.length})` },\n    { id: \'routing\', label: \'Routing & .htaccess\' },\n    { id: \'assets\', label: \'Asset Paths\' },\n    { id: \'code\', label: \'Code & Localhost\' },\n    { id: \'security\', label: \'Security\' },\n    { id: \'seo\', label: \'SEO & Meta\' },\n  ];\n\n  const filteredFixes =\n    activeCategory === \'all\'\n      ? fixes\n      : fixes.filter((f) => f.category === activeCategory);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Wrench className=\"w-5 h-5 text-[#5b8cff]\" />\n            Hostinger Compatibility Repair Engine\n          </h1>\n          <p className=\"text-xs text-white/50 mt-1\">\n            Automated code adjustments, server configurations, and path normalizations.\n          </p>\n        </div>\n\n        <button\n          onClick={onRunDeepAiRepair}\n          disabled={isAiRepairing}\n          className=\"flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#5b8cff] to-[#7c5cff] hover:opacity-90 text-white disabled:opacity-50 transition-all shadow-md shadow-[#5b8cff]/20\"\n        >\n          {isAiRepairing ? (\n            <>\n              <div className=\"w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n              <span>Running Deep Repair...</span>\n            </>\n          ) : (\n            <>\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Run Deep AI Repair Pass</span>\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* Summary KPI Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        <div className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-[#3ddc8c]/15 text-[#3ddc8c] flex items-center justify-center font-mono font-extrabold text-xl\">\n            {fixCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-white/50 font-semibold uppercase tracking-wider font-mono\">\n              Fixes Applied\n            </div>\n            <div className=\"text-sm font-bold text-white\">Auto-configured for Hostinger</div>\n          </div>\n        </div>\n\n        <div className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-[#ffb547]/15 text-[#ffb547] flex items-center justify-center font-mono font-extrabold text-xl\">\n            {warnCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-white/50 font-semibold uppercase tracking-wider font-mono\">\n              Review Items\n            </div>\n            <div className=\"text-sm font-bold text-white\">Advisories & Key Settings</div>\n          </div>\n        </div>\n\n        <div className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-[#5b8cff]/15 text-[#5b8cff] flex items-center justify-center font-mono font-extrabold text-xl\">\n            {infoCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-white/50 font-semibold uppercase tracking-wider font-mono\">\n              Deployment Info\n            </div>\n            <div className=\"text-sm font-bold text-white\">Runtime & Structure Notes</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Category Filter Tabs */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 border-b border-white/10 text-xs\">\n        {categories.map((cat) => (\n          <button\n            key={cat.id}\n            onClick={() => setActiveCategory(cat.id)}\n            className={`px-3.5 py-1.5 rounded-lg font-medium whitespace-nowrap transition-all ${\n              activeCategory === cat.id\n                ? \'bg-white/10 text-white font-semibold\'\n                : \'text-white/50 hover:text-white hover:bg-white/5\'\n            }`}\n          >\n            {cat.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Fixes List */}\n      <div className=\"space-y-3\">\n        {filteredFixes.length === 0 ? (\n          <div className=\"p-8 text-center rounded-2xl bg-[#12121c] border border-white/10 text-white/40 text-xs\">\n            No fixes found in this category.\n          </div>\n        ) : (\n          filteredFixes.map((fix) => {\n            const isExpanded = expandedFixId === fix.id;\n            return (\n              <div\n                key={fix.id}\n                className={`rounded-2xl border transition-all overflow-hidden ${\n                  fix.type === \'fix\'\n                    ? \'bg-[#12121c] border-[#3ddc8c]/20\'\n                    : fix.type === \'warn\'\n                    ? \'bg-[#141210] border-[#ffb547]/30\'\n                    : \'bg-[#12121c] border-white/10\'\n                }`}\n              >\n                {/* Fix Item Row */}\n                <div\n                  onClick={() => setExpandedFixId(isExpanded ? null : fix.id)}\n                  className=\"p-4 flex items-center justify-between gap-4 cursor-pointer select-none hover:bg-white/[0.02]\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <span\n                      className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 ${\n                        fix.type === \'fix\'\n                          ? \'bg-[#3ddc8c]/20 text-[#3ddc8c]\'\n                          : fix.type === \'warn\'\n                          ? \'bg-[#ffb547]/20 text-[#ffb547]\'\n                          : \'bg-[#5b8cff]/20 text-[#5b8cff]\'\n                      }`}\n                    >\n                      {fix.type === \'fix\' ? (\n                        <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n                      ) : fix.type === \'warn\' ? (\n                        <AlertTriangle className=\"w-3.5 h-3.5\" />\n                      ) : (\n                        <Info className=\"w-3.5 h-3.5\" />\n                      )}\n                    </span>\n\n                    <div className=\"min-w-0\">\n                      <div className=\"font-semibold text-xs text-white truncate flex items-center gap-2\">\n                        <span>{fix.msg}</span>\n                        {fix.targetFile && (\n                          <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-white/50 border border-white/10\">\n                            {fix.targetFile}\n                          </span>\n                        )}\n                      </div>\n                      {fix.detail && (\n                        <p className=\"text-[11px] text-white/50 truncate mt-0.5\">{fix.detail}</p>\n                      )}\n                    </div>\n                  </div>\n\n                  <span className=\"text-[10px] font-mono uppercase tracking-wider text-white/40 shrink-0\">\n                    {fix.category}\n                  </span>\n                </div>\n\n                {/* Expanded Diff / Code Details */}\n                {isExpanded && (\n                  <div className=\"p-4 pt-0 border-t border-white/5 space-y-3 bg-black/30\">\n                    {fix.detail && (\n                      <p className=\"text-xs text-white/70 leading-relaxed\">{fix.detail}</p>\n                    )}\n\n                    {fix.diff && (\n                      <div className=\"rounded-xl bg-[#09090e] border border-white/10 p-3 font-mono text-xs overflow-x-auto\">\n                        <div className=\"text-[10px] uppercase font-bold text-[#5b8cff] mb-1.5 flex items-center gap-1.5\">\n                          <FileCode className=\"w-3 h-3\" />\n                          Generated / Updated Content:\n                        </div>\n                        <pre className=\"text-[#9ee5bd] text-[11px] whitespace-pre leading-relaxed\">\n                          {fix.diff.after}\n                        </pre>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            );\n          })\n        )}\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-4 border-t border-white/10\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] text-white transition-colors border border-white/10\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Analysis</span>\n        </button>\n\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[#5b8cff] hover:bg-[#4a7de8] text-white transition-all shadow-lg shadow-[#5b8cff]/20\"\n        >\n          <span>Continue to Build Config</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
