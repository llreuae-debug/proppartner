      replacement_content: "import React from \'react\';\nimport {\n  History,\n  Trash2,\n  Calendar,\n  Layers,\n  ArrowRight,\n  Sparkles,\n  Folder,\n} from \'lucide-react\';\nimport { HistoryItem } from \'../../types\';\n\ninterface HistoryViewProps {\n  history: HistoryItem[];\n  onDeleteHistoryItem: (id: string) => void;\n  onClearHistory: () => void;\n  onNewConversion: () => void;\n}\n\nexport const HistoryView: React.FC<HistoryViewProps> = ({\n  history,\n  onDeleteHistoryItem,\n  onClearHistory,\n  onNewConversion,\n}) => {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <History className=\"w-5 h-5 text-[#5b8cff]\" />\n            Conversion Workspace History\n          </h1>\n          <p className=\"text-xs text-white/50 mt-1\">\n            Persisted history of previously analyzed and converted Hostinger packages.\n          </p>\n        </div>\n\n        {history.length > 0 && (\n          <button\n            onClick={onClearHistory}\n            className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 transition-colors\"\n          >\n            <Trash2 className=\"w-3.5 h-3.5\" />\n            <span>Clear History</span>\n          </button>\n        )}\n      </div>\n\n      {history.length === 0 ? (\n        <div className=\"p-12 text-center rounded-2xl bg-[#12121c] border border-white/10 flex flex-col items-center justify-center space-y-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white/30\">\n            <History className=\"w-6 h-6\" />\n          </div>\n          <div className=\"font-semibold text-sm text-white\">No Saved Conversions Yet</div>\n          <p className=\"text-xs text-white/50 max-w-sm\">\n            When you build and validate Hostinger deployment packages, save them to your library to track readiness scores and deployment targets.\n          </p>\n          <button\n            onClick={onNewConversion}\n            className=\"mt-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-[#5b8cff] text-white hover:bg-[#4a7de8] transition-colors\"\n          >\n            Start New Conversion\n          </button>\n        </div>\n      ) : (\n        <div className=\"space-y-3\">\n          {history.map((item) => (\n            <div\n              key={item.id}\n              className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 hover:border-white/20 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4\"\n            >\n              <div className=\"flex items-center gap-3.5 min-w-0\">\n                <div className=\"w-10 h-10 rounded-xl bg-white/[0.04] border border-white/10 flex items-center justify-center text-[#5b8cff] shrink-0 font-bold font-mono\">\n                  {item.score}%\n                </div>\n\n                <div className=\"min-w-0\">\n                  <div className=\"font-semibold text-xs text-white truncate flex items-center gap-2\">\n                    <span>{item.name}</span>\n                    <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-[#5b8cff]/15 text-[#9bb8ff] border border-[#5b8cff]/30\">\n                      {item.framework}\n                    </span>\n                    <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-white/50 border border-white/10 uppercase\">\n                      {item.mode}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-3 text-[11px] text-white/40 mt-1 font-mono\">\n                    <span className=\"flex items-center gap-1\">\n                      <Folder className=\"w-3 h-3 text-white/30\" />\n                      {item.fileCount} files\n                    </span>\n                    <span>\342\200\242</span>\n                    <span className=\"flex items-center gap-1\">\n                      <Calendar className=\"w-3 h-3 text-white/30\" />\n                      {item.date}\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-2 shrink-0\">\n                <button\n                  onClick={() => onDeleteHistoryItem(item.id)}\n                  className=\"w-8 h-8 rounded-lg flex items-center justify-center text-white/40 hover:text-red-400 hover:bg-red-500/10 transition-colors\"\n                  title=\"Delete record\"\n                >\n                  <Trash2 className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
