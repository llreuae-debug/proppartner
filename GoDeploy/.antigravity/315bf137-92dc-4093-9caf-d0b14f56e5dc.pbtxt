    replacement_infos {
      original_chunk {
        target_content: "export const Sidebar: React.FC<SidebarProps> = ({\n  currentView,\n  onSelectView,\n  maxReachedStepIndex,\n}) => {\n  return (\n    <aside className=\"w-60 border-r border-white/10 bg-[#08080c]/60 backdrop-blur-sm p-3 flex flex-col gap-1 overflow-y-auto shrink-0 select-none\">\n      <div className=\"text-[10px] uppercase tracking-widest text-white/40 font-semibold px-3 pt-3 pb-2 font-mono\">\n        Conversion Pipeline\n      </div>\n\n      <nav className=\"flex flex-col gap-1\">\n        {WORKFLOW_STEPS.map((step, idx) => {\n          const Icon = step.icon;\n          const isActive = currentView === step.key;\n          const isDone = idx < maxReachedStepIndex;\n          const isAvailable = idx <= maxReachedStepIndex;\n\n          return (\n            <button\n              key={step.key}\n              disabled={!isAvailable}\n              onClick={() => onSelectView(step.key)}\n              className={`w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-medium transition-all text-left relative border ${\n                isActive\n                  ? \'bg-[#5b8cff]/15 text-white border-[#5b8cff]/30 shadow-sm shadow-[#5b8cff]/10 font-semibold\'\n                  : isAvailable\n                  ? \'text-white/70 hover:text-white hover:bg-white/[0.04] border-transparent\'\n                  : \'text-white/20 cursor-not-allowed border-transparent\'\n              }`}\n            >\n              <Icon\n                className={`w-4 h-4 shrink-0 ${\n                  isActive ? \'text-[#5b8cff]\' : isDone ? \'text-[#3ddc8c]\' : \'text-current\'\n                }`}\n              />\n              <span className=\"truncate\">{step.label}</span>\n\n              <span\n                className={`ml-auto w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] font-bold ${\n                  isActive\n                    ? \'bg-[#5b8cff] text-white shadow-sm\'\n                    : isDone\n                    ? \'bg-[#3ddc8c]/20 text-[#3ddc8c]\'\n                    : isAvailable\n                    ? \'bg-white/10 text-white/50\'\n                    : \'bg-white/5 text-white/20\'\n                }`}\n              >\n                {isDone ? <Check className=\"w-3 h-3 stroke-[2.5]\" /> : step.stepNum}\n              </span>\n            </button>\n          );\n        })}\n      </nav>\n\n      <div className=\"text-[10px] uppercase tracking-widest text-white/40 font-semibold px-3 pt-5 pb-2 font-mono\">\n        Workspace\n      </div>\n\n      <nav className=\"flex flex-col gap-1\">\n        <button\n          onClick={() => onSelectView(\'history\')}\n          className={`w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-medium transition-all text-left border ${\n            currentView === \'history\'\n              ? \'bg-[#5b8cff]/15 text-white border-[#5b8cff]/30\'\n              : \'text-white/70 hover:text-white hover:bg-white/[0.04] border-transparent\'\n          }`}\n        >\n          <History className=\"w-4 h-4 text-white/60 shrink-0\" />\n          <span>Conversion History</span>\n        </button>\n      </nav>\n\n      <div className=\"mt-auto pt-6 px-3\">\n        <div className=\"p-3 rounded-xl bg-gradient-to-b from-white/[0.04] to-transparent border border-white/5 text-[11px] text-white/50\">\n          <div className=\"font-semibold text-white/80 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-[#5b8cff]\" />\n            Hostinger Ready\n          </div>\n          Generates optimized .htaccess, static builds, and hPanel deployment packages.\n        </div>\n      </div>\n    </aside>\n  );\n};"
        replacement_content: "export const Sidebar: React.FC<SidebarProps> = ({\n  currentView,\n  onSelectView,\n  maxReachedStepIndex,\n}) => {\n  return (\n    <aside className=\"w-60 border-r border-slate-800 bg-slate-950/70 backdrop-blur-md p-3.5 flex flex-col gap-1 overflow-y-auto shrink-0 select-none\">\n      <div className=\"text-[10px] uppercase tracking-widest text-slate-400 font-bold px-3 pt-2 pb-2 font-mono\">\n        Conversion Pipeline\n      </div>\n\n      <nav className=\"flex flex-col gap-1.5\">\n        {WORKFLOW_STEPS.map((step, idx) => {\n          const Icon = step.icon;\n          const isActive = currentView === step.key;\n          const isDone = idx < maxReachedStepIndex;\n          const isAvailable = idx <= maxReachedStepIndex;\n\n          return (\n            <button\n              key={step.key}\n              disabled={!isAvailable}\n              onClick={() => onSelectView(step.key)}\n              className={`w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-medium transition-all text-left relative border ${\n                isActive\n                  ? \'bg-indigo-600/15 text-white border-indigo-500/40 shadow-sm shadow-indigo-500/10 font-semibold\'\n                  : isAvailable\n                  ? \'text-slate-300 hover:text-white hover:bg-slate-900/80 border-transparent hover:border-slate-800\'\n                  : \'text-slate-600 cursor-not-allowed border-transparent\'\n              }`}\n            >\n              <Icon\n                className={`w-4 h-4 shrink-0 ${\n                  isActive ? \'text-indigo-400\' : isDone ? \'text-emerald-400\' : \'text-current\'\n                }`}\n              />\n              <span className=\"truncate\">{step.label}</span>\n\n              <span\n                className={`ml-auto w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] font-bold ${\n                  isActive\n                    ? \'bg-indigo-600 text-white shadow-sm\'\n                    : isDone\n                    ? \'bg-emerald-500/20 text-emerald-400\'\n                    : isAvailable\n                    ? \'bg-slate-800 text-slate-400\'\n                    : \'bg-slate-900 text-slate-700\'\n                }`}\n              >\n                {isDone ? <Check className=\"w-3 h-3 stroke-[2.5]\" /> : step.stepNum}\n              </span>\n            </button>\n          );\n        })}\n      </nav>\n\n      <div className=\"text-[10px] uppercase tracking-widest text-slate-400 font-bold px-3 pt-5 pb-2 font-mono\">\n        Workspace\n      </div>\n\n      <nav className=\"flex flex-col gap-1.5\">\n        <button\n          onClick={() => onSelectView(\'history\')}\n          className={`w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-medium transition-all text-left border ${\n            currentView === \'history\'\n              ? \'bg-indigo-600/15 text-white border-indigo-500/40\'\n              : \'text-slate-300 hover:text-white hover:bg-slate-900/80 border-transparent hover:border-slate-800\'\n          }`}\n        >\n          <History className=\"w-4 h-4 text-slate-400 shrink-0\" />\n          <span>Conversion History</span>\n        </button>\n      </nav>\n\n      <div className=\"mt-auto pt-6 px-1\">\n        <div className=\"p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800 text-[11px] text-slate-400 shadow-sm\">\n          <div className=\"font-semibold text-slate-200 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-indigo-500\" />\n            Hostinger Ready\n          </div>\n          Generates optimized .htaccess, static builds, and hPanel deployment packages.\n        </div>\n      </div>\n    </aside>\n  );\n};"
      }
      num_matches: 1
    }
  }
