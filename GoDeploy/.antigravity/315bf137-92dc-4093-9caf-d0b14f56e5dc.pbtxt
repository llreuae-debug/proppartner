          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  lines.push(\'Generated by GoDeploy \342\200\242 Production-Ready Deployment Converter\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
