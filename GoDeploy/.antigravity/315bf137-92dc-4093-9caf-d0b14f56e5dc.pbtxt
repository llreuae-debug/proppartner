    replacement_chunks {
      target_content: "import React from \'react\';\nimport { PlusCircle, Globe, ShieldCheck, RefreshCw } from \'lucide-react\';\nimport { ProjectData } from \'../types\';\nimport { Logo } from \'./Logo\';\n\ninterface TopbarProps {\n  project: ProjectData | null;\n  statusLabel: string;\n  onReset: () => void;\n}\n\nexport const Topbar: React.FC<TopbarProps> = ({ project, statusLabel, onReset }) => {\n  return (\n    <header className=\"h-14 border-b border-slate-800 bg-slate-950/80 backdrop-blur-md px-5 flex items-center justify-between z-20 shrink-0\">\n      <div className=\"flex items-center gap-3\">\n        <Logo size=\"md\" />\n        <span className=\"hidden sm:inline-flex items-center gap-1.5 text-xs text-slate-400 font-mono border-l border-slate-800 pl-3 ml-1\">\n          <Globe className=\"w-3.5 h-3.5 text-indigo-400\" />\n          AI Website \342\206\222 Hostinger Ready\n        </span>\n      </div>\n\n      <div className=\"flex items-center gap-3\">\n        <div className=\"flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-slate-900 border border-slate-800 text-slate-200\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_#34d399]\" />\n          <span>{statusLabel}</span>\n        </div>\n\n        {project && (\n          <button\n            onClick={onReset}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/60 transition-colors shadow-sm\"\n            title=\"Start new conversion\"\n          >\n            <PlusCircle className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">New Project</span>\n          </button>\n        )}\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { PlusCircle, Globe } from \'lucide-react\';\nimport { ProjectData } from \'../types\';\nimport { Logo } from \'./Logo\';\nimport { LanguageSelector } from \'./LanguageSelector\';\nimport { useI18n } from \'../i18n/context\';\n\ninterface TopbarProps {\n  project: ProjectData | null;\n  statusLabel: string;\n  onReset: () => void;\n}\n\nexport const Topbar: React.FC<TopbarProps> = ({ project, statusLabel, onReset }) => {\n  const { t } = useI18n();\n\n  return (\n    <header className=\"h-14 border-b border-slate-800 bg-slate-950/80 backdrop-blur-md px-4 sm:px-5 flex items-center justify-between z-20 shrink-0\">\n      <div className=\"flex items-center gap-3\">\n        <Logo size=\"md\" />\n        <span className=\"hidden sm:inline-flex items-center gap-1.5 text-xs text-slate-400 font-mono border-l border-slate-800 pl-3 ml-1\">\n          <Globe className=\"w-3.5 h-3.5 text-indigo-400\" />\n          {t(\'brand.tagline\')}\n        </span>\n      </div>\n\n      <div className=\"flex items-center gap-2.5\">\n        <div className=\"hidden xs:flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-slate-900 border border-slate-800 text-slate-200\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_#34d399]\" />\n          <span>{statusLabel}</span>\n        </div>\n\n        <LanguageSelector />\n\n        {project && (\n          <button\n            onClick={onReset}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/60 transition-colors shadow-sm\"\n            title={t(\'topbar.new_project\')}\n          >\n            <PlusCircle className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">{t(\'topbar.new_project\')}</span>\n          </button>\n        )}\n      </div>\n    </header>\n  );\n};\n"
