  file_change {
    absolute_path_uri: "file:///src/components/views/DownloadView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  DownloadCloud,\n  FileText,\n  Copy,\n  Check,\n  ExternalLink,\n  ShieldCheck,\n  Eye,\n  ArrowLeft,\n  Server,\n  Layers,\n  Sparkles,\n} from \'lucide-react\';\nimport { AnalysisResult, BuiltPackageResult, EnvVariableConfig, ProjectData } from \'../../types\';\n\ninterface DownloadViewProps {\n  project: ProjectData;\n  analysis: AnalysisResult;\n  packageBlob: BuiltPackageResult | null;\n  envVars: EnvVariableConfig[];\n  onDownloadZip: () => void;\n  onDownloadReport: () => void;\n  onCopyInstructions: () => void;\n  onNext: () => void;\n  onPrev: () => void;\n}\n\nexport const DownloadView: React.FC<DownloadViewProps> = ({\n  project,\n  analysis,\n  packageBlob,\n  envVars,\n  onDownloadZip,\n  onDownloadReport,\n  onCopyInstructions,\n  onNext,\n  onPrev,\n}) => {\n  const [copied, setCopied] = useState(false);\n\n  const formatBytes = (bytes: number) => {\n    if (bytes === 0) return \'0 B\';\n    const k = 1024;\n    const sizes = [\'B\', \'KB\', \'MB\', \'GB\'];\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n    return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;\n  };\n\n  const handleCopy = () => {\n    onCopyInstructions();\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <DownloadCloud className=\"w-5 h-5 text-[#3ddc8c]\" />\n            Hostinger Download Center\n          </h1>\n          <p className=\"text-xs text-white/50 mt-1\">\n            Your production package is ready for direct extraction on Hostinger hPanel.\n          </p>\n        </div>\n      </div>\n\n      {/* Hero Download Card */}\n      <div className=\"p-6 rounded-2xl bg-gradient-to-r from-[#3ddc8c]/10 via-[#5b8cff]/10 to-transparent border border-[#3ddc8c]/30 shadow-xl shadow-[#3ddc8c]/5\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#3ddc8c]/20 text-[#3ddc8c] border border-[#3ddc8c]/30 uppercase\">\n                PRODUCTION ARCHIVE READY\n              </span>\n              <span className=\"text-xs text-white/50 font-mono\">\n                Target: {packageBlob?.mode.toUpperCase() || \'STATIC\'}\n              </span>\n            </div>\n\n            <h2 className=\"text-lg font-bold text-white font-mono\">{packageBlob?.name || \'website-hostinger-ready.zip\'}</h2>\n            <div className=\"text-xs text-white/60\">\n              Size: <strong className=\"text-white\">{packageBlob ? formatBytes(packageBlob.size) : \'Calculated\'}</strong> \342\200\242 Contains verified .htaccess, assets, sitemaps, and deployment guide.\n            </div>\n          </div>\n\n          <button\n            onClick={onDownloadZip}\n            className=\"flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl text-sm font-bold bg-gradient-to-r from-[#3ddc8c] to-[#36c27b] text-black hover:opacity-95 transition-all shadow-xl shadow-[#3ddc8c]/25 shrink-0\"\n          >\n            <DownloadCloud className=\"w-5 h-5 stroke-[2.5]\" />\n            <span>Download Hostinger ZIP</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Action Buttons Grid */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <button\n          onClick={onDownloadReport}\n          className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 hover:border-white/20 text-left transition-all flex items-center justify-between group\"\n        >\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-white/[0.04] border border-white/10 flex items-center justify-center text-[#5b8cff]\">\n              <FileText className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"font-semibold text-xs text-white group-hover:text-[#5b8cff] transition-colors\">\n                Download Conversion Report (.html)\n              </div>\n              <div className=\"text-[11px] text-white/50\">Comprehensive audit and architecture record</div>\n            </div>\n          </div>\n          <span className=\"text-xs text-white/40 font-mono\">HTML</span>\n        </button>\n\n        <button\n          onClick={handleCopy}\n          className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 hover:border-white/20 text-left transition-all flex items-center justify-between group\"\n        >\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-white/[0.04] border border-white/10 flex items-center justify-center text-[#7c5cff]\">\n              {copied ? <Check className=\"w-5 h-5 text-[#3ddc8c]\" /> : <Copy className=\"w-5 h-5\" />}\n            </div>\n            <div>\n              <div className=\"font-semibold text-xs text-white group-hover:text-[#7c5cff] transition-colors\">\n                {copied ? \'Instructions Copied!\' : \'Copy Deployment Markdown\'}\n              </div>\n              <div className=\"text-[11px] text-white/50\">Full step-by-step Hostinger checklist</div>\n            </div>\n          </div>\n          <span className=\"text-xs text-white/40 font-mono\">MD</span>\n        </button>\n      </div>\n\n      {/* Step-by-Step Hostinger Deployment Checklist */}\n      <div className=\"p-6 rounded-2xl bg-[#12121c] border border-white/10 space-y-4\">\n        <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n          <Server className=\"w-4 h-4 text-[#5b8cff]\" />\n          Hostinger hPanel Deployment Walkthrough\n        </h2>\n\n        <div className=\"space-y-3\">\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#5b8cff]/20 text-[#5b8cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              1\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Log in to Hostinger hPanel</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Open <a href=\"https://hpanel.hostinger.com\" target=\"_blank\" rel=\"noreferrer\" className=\"text-[#5b8cff] underline inline-flex items-center gap-1\">hpanel.hostinger.com <ExternalLink className=\"w-3 h-3\" /></a>, select your hosting plan, and click <strong>Manage</strong>.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#5b8cff]/20 text-[#5b8cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              2\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Open File Manager &amp; Upload Archive</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Go to <strong>Files \342\206\222 File Manager</strong>. Navigate inside the <code className=\"text-[#9bb8ff] font-mono\">public_html</code> folder and upload your downloaded <code className=\"text-[#9bb8ff] font-mono\">{packageBlob?.name || \'website-hostinger-ready.zip\'}</code>.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#5b8cff]/20 text-[#5b8cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              3\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Extract Archive into Webroot</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Right-click the uploaded zip and choose <strong>Extract</strong>. Ensure <code className=\"text-[#9bb8ff] font-mono\">index.html</code> (or <code className=\"text-[#9bb8ff] font-mono\">index.php</code>) and <code className=\"text-[#9bb8ff] font-mono\">.htaccess</code> sit directly in <code className=\"text-[#9bb8ff] font-mono\">public_html</code>.\n              </p>\n            </div>\n          </div>\n\n          {envVars.length > 0 && (\n            <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n              <span className=\"w-6 h-6 rounded-full bg-[#7c5cff]/20 text-[#7c5cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n                4\n              </span>\n              <div className=\"space-y-1\">\n                <div className=\"font-semibold text-white\">Set Environment Variables (.env)</div>\n                <p className=\"text-white/50 leading-relaxed\">\n                  Rename <code className=\"text-[#9bb8ff] font-mono\">.env.example</code> to <code className=\"text-[#9bb8ff] font-mono\">.env</code> in File Manager and paste your live API secrets and keys.\n                </p>\n              </div>\n            </div>\n          )}\n\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#3ddc8c]/20 text-[#3ddc8c] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              {envVars.length > 0 ? 5 : 4}\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Verify Free SSL &amp; Domain</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Check <strong>Security \342\206\222 SSL</strong> in hPanel to make sure Let\'s Encrypt SSL is active. Your website is ready for the world!\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-2\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] text-white transition-colors border border-white/10\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Validator</span>\n        </button>\n\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[#5b8cff] hover:bg-[#4a7de8] text-white transition-all shadow-lg shadow-[#5b8cff]/20\"\n        >\n          <span>Open Interactive Live Preview</span>\n          <Eye className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
