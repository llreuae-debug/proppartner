  file_change {
    absolute_path_uri: "file:///src/components/views/ImportView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef } from \'react\';\nimport {\n  UploadCloud,\n  Globe,\n  FolderOpen,\n  FileCode2,\n  Sparkles,\n  Zap,\n  ArrowRight,\n  ShieldAlert,\n  Layers,\n  CheckCircle2,\n  FileArchive,\n} from \'lucide-react\';\nimport { getSampleProjects } from \'../../utils/samples\';\nimport { ProjectData } from \'../../types\';\n\ninterface ImportViewProps {\n  onImportProject: (project: ProjectData) => void;\n  onImportUrl: (url: string) => Promise<void>;\n  isLoadingUrl: boolean;\n  onSelectSample: (sample: () => ProjectData) => void;\n}\n\nexport const ImportView: React.FC<ImportViewProps> = ({\n  onImportProject,\n  onImportUrl,\n  isLoadingUrl,\n  onSelectSample,\n}) => {\n  const [urlInput, setUrlInput] = useState(\'\');\n  const [isDragOver, setIsDragOver] = useState(false);\n  const [selectedPlatform, setSelectedPlatform] = useState(\'auto\');\n\n  const zipInputRef = useRef<HTMLInputElement>(null);\n  const folderInputRef = useRef<HTMLInputElement>(null);\n  const filesInputRef = useRef<HTMLInputElement>(null);\n\n  const samples = getSampleProjects();\n\n  const handleUrlSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (urlInput.trim()) {\n      onImportUrl(urlInput.trim());\n    }\n  };\n\n  const handleZipChange = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    try {\n      const JSZip = (await import(\'jszip\')).default;\n      const zip = await JSZip.loadAsync(file);\n      const files: Record<string, { content: string | null; bin?: Uint8Array }> = {};\n      let fileCount = 0;\n\n      const entries = Object.values(zip.files).filter((f) => !f.dir);\n      for (const entry of entries) {\n        if (/(__MACOSX|\\.DS_Store|node_modules\\/|\\.git\\/)/.test(entry.name)) continue;\n        const ext = (entry.name.split(\'.\').pop() || \'\').toLowerCase();\n        const textExts = [\n          \'html\', \'htm\', \'css\', \'js\', \'jsx\', \'ts\', \'tsx\', \'vue\', \'svelte\', \'json\',\n          \'md\', \'txt\', \'env\', \'example\', \'yml\', \'yaml\', \'xml\', \'svg\', \'htaccess\',\n          \'gitignore\', \'php\', \'py\', \'rb\', \'sql\', \'mjs\', \'cjs\', \'ini\', \'sh\',\n        ];\n\n        if (textExts.includes(ext)) {\n          try {\n            const txt = await entry.async(\'string\');\n            files[entry.name] = { content: txt };\n          } catch {\n            const bin = await entry.async(\'uint8array\');\n            files[entry.name] = { content: null, bin };\n          }\n        } else {\n          try {\n            const bin = await entry.async(\'uint8array\');\n            files[entry.name] = { content: null, bin };\n          } catch {\n            // ignore\n          }\n        }\n        fileCount++;\n      }\n\n      onImportProject({\n        name: file.name.replace(/\\.zip$/i, \'\'),\n        source: \'zip\',\n        files,\n        fileCount,\n        importedAt: new Date().toISOString(),\n      });\n    } catch (err: any) {\n      alert(`Error reading zip file: ${err.message}`);\n    }\n  };\n\n  const handleFolderChange = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const fileList = e.target.files;\n    if (!fileList || fileList.length === 0) return;\n\n    const files: Record<string, { content: string | null; bin?: Uint8Array }> = {};\n    let fileCount = 0;\n    let baseName = \'imported-project\';\n\n    const textExts = [\n      \'html\', \'htm\', \'css\', \'js\', \'jsx\', \'ts\', \'tsx\', \'vue\', \'svelte\', \'json\',\n      \'md\', \'txt\', \'env\', \'example\', \'yml\', \'yaml\', \'xml\', \'svg\', \'htaccess\',\n      \'gitignore\', \'php\', \'py\', \'rb\', \'sql\', \'mjs\', \'cjs\', \'ini\', \'sh\',\n    ];\n\n    for (let i = 0; i < fileList.length; i++) {\n      const file = fileList[i];\n      let path = file.webkitRelativePath || file.name;\n      const parts = path.split(\'/\');\n      if (parts.length > 1) {\n        if (baseName === \'imported-project\') baseName = parts[0];\n        path = parts.slice(1).join(\'/\');\n      }\n      if (!path || /(node_modules\\/|\\.git\\/|\\.DS_Store|__MACOSX)/.test(path)) continue;\n\n      const ext = (path.split(\'.\').pop() || \'\').toLowerCase();\n      if (textExts.includes(ext) || file.type.startsWith(\'text/\')) {\n        try {\n          const txt = await file.text();\n          files[path] = { content: txt };\n        } catch {\n          const bin = new Uint8Array(await file.arrayBuffer());\n          files[path] = { content: null, bin };\n        }\n      } else {\n        const bin = new Uint8Array(await file.arrayBuffer());\n        files[path] = { content: null, bin };\n      }\n      fileCount++;\n    }\n\n    onImportProject({\n      name: baseName,\n      source: \'folder\',\n      files,\n      fileCount,\n      importedAt: new Date().toISOString(),\n    });\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragOver(false);\n    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {\n      const file = e.dataTransfer.files[0];\n      if (file.name.endsWith(\'.zip\')) {\n        // Trigger simulated input\n        if (zipInputRef.current) {\n          const dt = new DataTransfer();\n          dt.items.add(file);\n          zipInputRef.current.files = dt.files;\n          handleZipChange({ target: { files: dt.files } } as any);\n        }\n      }\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Hero Banner */}\n      <div className=\"text-center py-8 px-6 rounded-2xl bg-gradient-to-b from-[#5b8cff]/10 via-[#7c5cff]/5 to-transparent border border-white/10 relative overflow-hidden\">\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-white/[0.06] border border-white/10 text-[#9bb8ff] mb-4\">\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          Autonomous Hostinger Migration Engine\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n          Deploy AI-Generated Websites to <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-[#5b8cff] to-[#7c5cff]\">Hostinger</span>\n        </h1>\n        <p className=\"text-sm text-white/60 max-w-xl mx-auto mt-2 leading-relaxed\">\n          Import source code from AI Studio, Lovable, Replit, or GitHub. Automatically fix asset paths, SPA routes, localhost URLs, and package ready-to-upload Hostinger archives.\n        </p>\n\n        {/* Source Badges */}\n        <div className=\"flex flex-wrap justify-center gap-2 mt-5 text-[11px] font-mono text-white/50\">\n          <span className=\"px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/5\">Google AI Studio</span>\n          <span className=\"px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/5\">Lovable</span>\n          <span className=\"px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/5\">Replit</span>\n          <span className=\"px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/5\">GitHub</span>\n          <span className=\"px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/5\">Vite / React</span>\n          <span className=\"px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/5\">Next.js / Node</span>\n          <span className=\"px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/5\">PHP / WordPress</span>\n        </div>\n      </div>\n\n      {/* Main Import Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n        {/* Upload Zone (Left 7 cols) */}\n        <div className=\"lg:col-span-7 space-y-4\">\n          <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <FileArchive className=\"w-4 h-4 text-[#5b8cff]\" />\n                Upload Project Source Code\n              </h2>\n              <span className=\"text-[11px] text-[#3ddc8c] font-mono font-medium\">Recommended for full conversion</span>\n            </div>\n\n            {/* Drag & Drop Area */}\n            <div\n              onDragOver={(e) => {\n                e.preventDefault();\n                setIsDragOver(true);\n              }}\n              onDragLeave={() => setIsDragOver(false)}\n              onDrop={handleDrop}\n              onClick={() => zipInputRef.current?.click()}\n              className={`border-2 border-dashed rounded-xl p-8 text-center cursor-pointer transition-all ${\n                isDragOver\n                  ? \'border-[#5b8cff] bg-[#5b8cff]/10 scale-[0.99]\'\n                  : \'border-white/15 bg-white/[0.01] hover:border-white/30 hover:bg-white/[0.03]\'\n              }`}\n            >\n              <UploadCloud className=\"w-10 h-10 text-white/40 mx-auto mb-3\" />\n              <div className=\"font-semibold text-sm text-white mb-1\">\n                Drop your project ZIP file here\n              </div>\n              <div className=\"text-xs text-white/50 mb-4\">\n                Supports .zip archives exported from Google AI Studio, Lovable, GitHub, or local workspaces\n              </div>\n\n              <div className=\"inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-[#5b8cff] text-white shadow-lg shadow-[#5b8cff]/20\">\n                Browse ZIP Archive\n              </div>\n            </div>\n\n            {/* Hidden Inputs */}\n            <input\n              type=\"file\"\n              ref={zipInputRef}\n              accept=\".zip\"\n              onChange={handleZipChange}\n              className=\"hidden\"\n            />\n            <input\n              type=\"file\"\n              ref={folderInputRef}\n              {...({ webkitdirectory: \'\', directory: \'\', multiple: true } as any)}\n              onChange={handleFolderChange}\n              className=\"hidden\"\n            />\n\n            {/* Folder & Files buttons */}\n            <div className=\"flex items-center justify-center gap-3 mt-4 pt-3 border-t border-white/5\">\n              <button\n                onClick={() => folderInputRef.current?.click()}\n                className=\"flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-white/80 transition-colors\"\n              >\n                <FolderOpen className=\"w-4 h-4 text-[#7c5cff]\" />\n                Upload Project Folder\n              </button>\n            </div>\n          </div>\n\n          {/* URL Import Card */}\n          <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10\">\n            <div className=\"flex items-center justify-between mb-2\">\n              <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <Globe className=\"w-4 h-4 text-[#5b8cff]\" />\n                Import from Live Web URL / Snapshot\n              </h2>\n            </div>\n            <p className=\"text-xs text-white/50 mb-3\">\n              Enter a public website URL or AI preview link to fetch the rendered client DOM snapshot.\n            </p>\n\n            <form onSubmit={handleUrlSubmit} className=\"flex gap-2\">\n              <input\n                type=\"text\"\n                value={urlInput}\n                onChange={(e) => setUrlInput(e.target.value)}\n                placeholder=\"https://preview.lovable.app/... or https://example.com\"\n                className=\"flex-1 px-3.5 py-2.5 rounded-xl bg-black/40 border border-white/15 text-xs text-white placeholder-white/30 focus:outline-none focus:border-[#5b8cff] font-mono\"\n              />\n              <button\n                type=\"submit\"\n                disabled={isLoadingUrl || !urlInput.trim()}\n                className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-[#5b8cff] hover:bg-[#4a7de8] text-white disabled:opacity-50 disabled:cursor-not-allowed transition-colors shrink-0 shadow-md shadow-[#5b8cff]/20\"\n              >\n                {isLoadingUrl ? (\n                  <>\n                    <div className=\"w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                    <span>Fetching...</span>\n                  </>\n                ) : (\n                  <>\n                    <span>Import URL</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </>\n                )}\n              </button>\n            </form>\n          </div>\n        </div>\n\n        {/* Preset Sample Projects (Right 5 cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10 h-full flex flex-col\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <Zap className=\"w-4 h-4 text-[#ffb547]\" />\n                Try Interactive Sample Projects\n              </h2>\n              <span className=\"text-[11px] text-white/40 font-mono\">1-Click Test</span>\n            </div>\n            <p className=\"text-xs text-white/50 mb-4\">\n              Instantly test the Hostinger conversion pipeline using pre-loaded AI web application templates.\n            </p>\n\n            <div className=\"grid grid-cols-1 gap-2.5 flex-1\">\n              {samples.map((sample) => (\n                <button\n                  key={sample.id}\n                  onClick={() => onSelectSample(sample.getProject)}\n                  className=\"w-full p-3 rounded-xl bg-white/[0.02] hover:bg-white/[0.06] border border-white/5 hover:border-white/15 text-left transition-all group flex items-start gap-3\"\n                >\n                  <div className=\"w-9 h-9 rounded-xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform\">\n                    {sample.icon}\n                  </div>\n                  <div className=\"flex-1 min-w-0\">\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"font-semibold text-xs text-white truncate\">{sample.title}</div>\n                      <span className=\"text-[10px] font-mono px-2 py-0.5 rounded-md bg-[#5b8cff]/15 text-[#9bb8ff] border border-[#5b8cff]/20\">\n                        {sample.framework}\n                      </span>\n                    </div>\n                    <p className=\"text-[11px] text-white/50 line-clamp-2 mt-1 leading-normal\">\n                      {sample.desc}\n                    </p>\n                  </div>\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Capabilities Overview Grid */}\n      <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10\">\n        <h3 className=\"text-xs font-bold uppercase tracking-wider text-white/60 font-mono mb-4 flex items-center gap-2\">\n          <Layers className=\"w-4 h-4 text-[#5b8cff]\" />\n          What WEBSITE2HOST Automates for Hostinger\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-xs\">\n          <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 space-y-1\">\n            <div className=\"font-semibold text-white flex items-center gap-1.5 text-[#3ddc8c]\">\n              <CheckCircle2 className=\"w-3.5 h-3.5\" />\n              SPA Route & 404 Prevention\n            </div>\n            <p className=\"text-white/60 leading-relaxed\">\n              Generates production LiteSpeed/Apache <code className=\"text-[#9bb8ff] font-mono\">.htaccess</code> rewrite rules so React, Vue, and Vite client routers load deep URLs cleanly.\n            </p>\n          </div>\n\n          <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 space-y-1\">\n            <div className=\"font-semibold text-white flex items-center gap-1.5 text-[#3ddc8c]\">\n              <CheckCircle2 className=\"w-3.5 h-3.5\" />\n              Asset & Localhost Cleanup\n            </div>\n            <p className=\"text-white/60 leading-relaxed\">\n              Strips hardcoded <code className=\"text-[#9bb8ff] font-mono\">http://localhost</code> origins and normalizes leading root asset paths for seamless public_html serving.\n            </p>\n          </div>\n\n          <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 space-y-1\">\n            <div className=\"font-semibold text-white flex items-center gap-1.5 text-[#3ddc8c]\">\n              <CheckCircle2 className=\"w-3.5 h-3.5\" />\n              Security & hPanel Guides\n            </div>\n            <p className=\"text-white/60 leading-relaxed\">\n              Audits secret keys in client bundles, formats <code className=\"text-[#9bb8ff] font-mono\">.env.example</code>, and outputs custom step-by-step hPanel deployment instructions.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
