>\n              <span className=\"text-3xl font-black text-white font-mono tracking-tight\">\n                {validation.score}%\n              </span>\n              <span className=\"text-[10px] uppercase font-bold text-white/50 tracking-wider\">\n                Readiness\n              </span>\n            </div>\n          </div>\n\n          {/* Validation Metrics */}\n          <div className=\"flex-1 w-full grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs\">\n            <div className=\"p-4 rounded-xl bg-[#3ddc8c]/5 border border-[#3ddc8c]/20 flex flex-col justify-between\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-white/60 font-medium\">Passed Checks</span>\n                <CheckCircle2 className=\"w-4 h-4 text-[#3ddc8c]\" />\n              </div>\n              <span className=\"text-2xl font-bold text-[#3ddc8c] font-mono mt-2\">\n                {validation.passCount}\n              </span>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-[#ffb547]/5 border border-[#ffb547]/20 flex flex-col justify-between\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-white/60 font-medium\">Advisories</span>\n                <AlertTriangle className=\"w-4 h-4 text-[#ffb547]\" />\n              </div>\n              <span className=\"text-2xl font-bold text-[#ffb547] font-mono mt-2\">\n                {validation.warnCount}\n              </span>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-[#ff5d6c]/5 border border-[#ff5d6c]/20 flex flex-col justify-between\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-white/60 font-medium\">Critical Failures</span>\n                <XCircle className=\"w-4 h-4 text-[#ff5d6c]\" />\n              </div>\n              <span className=\"text-2xl font-bold text-[#ff5d6c] font-mono mt-2\">\n                {validation.failCount}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Detailed Checks Checklist */}\n      <div className=\"p-6 rounded-2xl bg-[#12121c] border border-white/10 space-y-4\">\n        <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n          <span>Verification Checklist</span>\n          <span className=\"text-xs font-mono text-white/40\">({validation.checks.length} rules)</span>\n        </h2>\n\n        <div className=\"space-y-2.5\">\n          {validation.checks.map((check) => {\n            return (\n              <div\n                key={check.id}\n                className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start justify-between gap-4 text-xs\"\n              >\n                <div className=\"flex items-start gap-3 min-w-0\">\n                  <span\n                    className={`w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${\n                      check.status === \'pass\'\n                        ? \'bg-[#3ddc8c]/20 text-[#3ddc8c]\'\n                        : check.status === \'warn\'\n                        ? \'bg-[#ffb547]/20 text-[#ffb547]\'\n                        : \'bg-[#ff5d6c]/20 text-[#ff5d6c]\'\n                    }`}\n                  >\n                    {check.status === \'pass\' ? (\n                      <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                    ) : check.status === \'warn\' ? (\n                      <AlertTriangle className=\"w-3.5 h-3.5\" />\n                    ) : (\n                      <XCircle className=\"w-3.5 h-3.5\" />\n                    )}\n                  </span>\n\n                  <div className=\"min-w-0\">\n                    <div className=\"font-semibold text-white truncate\">{check.name}</div>\n                    <div className=\"text-[11px] text-white/50 mt-0.5 leading-relaxed\">\n                      {check.detail}\n                    </div>\n                  </div>\n                </div>\n\n                <span\n                  className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase shrink-0 ${\n                    check.status === \'pass\'\n                      ? \'bg-[#3ddc8c]/15 text-[#3ddc8c] border border-[#3ddc8c]/30\'\n                      : check.status === \'warn\'\n                      ? \'bg-[#ffb547]/15 text-[#ffb547] border border-[#ffb547]/30\'\n                      : \'bg-[#ff5d6c]/15 text-[#ff5d6c] border border-[#ff5d6c]/30\'\n                  }`}\n                >\n                  {check.status === \'pass\' ? \'PASS\' : check.status === \'warn\' ? \'WARN\' : \'FAIL\'}\n                </span>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-2\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] text-white transition-colors border border-white/10\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Build Config</span>\n        </button>\n\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[#5b8cff] hover:bg-[#4a7de8] text-white transition-all shadow-lg shadow-[#5b8cff]/20\"\n        >\n          <span>Continue to Download Center</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );"
