& !analysis.backend) {\n    compat.frontend = \'err\';\n    score -= 30;\n  }\n  if (project.source === \'url-snapshot\' && !hasHtaccess) {\n    compat.backend = \'warn\';\n    compat.database = \'warn\';\n    compat.env = \'warn\';\n    score = Math.min(score, 60);\n  }\n\n  analysis.score = Math.max(10, Math.min(100, score));\n\n  return analysis;\n}"
