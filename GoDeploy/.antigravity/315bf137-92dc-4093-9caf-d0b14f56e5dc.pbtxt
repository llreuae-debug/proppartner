t-xs text-white group-hover:text-[#7c5cff] transition-colors\">\n                {copied ? \'Instructions Copied!\' : \'Copy Deployment Markdown\'}\n              </div>\n              <div className=\"text-[11px] text-white/50\">Full step-by-step Hostinger checklist</div>\n            </div>\n          </div>\n          <span className=\"text-xs text-white/40 font-mono\">MD</span>\n        </button>\n      </div>\n\n      {/* Step-by-Step Hostinger Deployment Checklist */}\n      <div className=\"p-6 rounded-2xl bg-[#12121c] border border-white/10 space-y-4\">\n        <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n          <Server className=\"w-4 h-4 text-[#5b8cff]\" />\n          Hostinger hPanel Deployment Walkthrough\n        </h2>\n\n        <div className=\"space-y-3\">\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#5b8cff]/20 text-[#5b8cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              1\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Log in to Hostinger hPanel</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Open <a href=\"https://hpanel.hostinger.com\" target=\"_blank\" rel=\"noreferrer\" className=\"text-[#5b8cff] underline inline-flex items-center gap-1\">hpanel.hostinger.com <ExternalLink className=\"w-3 h-3\" /></a>, select your hosting plan, and click <strong>Manage</strong>.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#5b8cff]/20 text-[#5b8cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              2\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Open File Manager &amp; Upload Archive</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Go to <strong>Files \342\206\222 File Manager</strong>. Navigate inside the <code className=\"text-[#9bb8ff] font-mono\">public_html</code> folder and upload your downloaded <code className=\"text-[#9bb8ff] font-mono\">{packageBlob?.name || \'website-hostinger-ready.zip\'}</code>.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#5b8cff]/20 text-[#5b8cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              3\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Extract Archive into Webroot</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Right-click the uploaded zip and choose <strong>Extract</strong>. Ensure <code className=\"text-[#9bb8ff] font-mono\">index.html</code> (or <code className=\"text-[#9bb8ff] font-mono\">index.php</code>) and <code className=\"text-[#9bb8ff] font-mono\">.htaccess</code> sit directly in <code className=\"text-[#9bb8ff] font-mono\">public_html</code>.\n              </p>\n            </div>\n          </div>\n\n          {envVars.length > 0 && (\n            <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n              <span className=\"w-6 h-6 rounded-full bg-[#7c5cff]/20 text-[#7c5cff] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n                4\n              </span>\n              <div className=\"space-y-1\">\n                <div className=\"font-semibold text-white\">Set Environment Variables (.env)</div>\n                <p className=\"text-white/50 leading-relaxed\">\n                  Rename <code className=\"text-[#9bb8ff] font-mono\">.env.example</code> to <code className=\"text-[#9bb8ff] font-mono\">.env</code> in File Manager and paste your live API secrets and keys.\n                </p>\n              </div>\n            </div>\n          )}\n\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex items-start gap-3.5 text-xs\">\n            <span className=\"w-6 h-6 rounded-full bg-[#3ddc8c]/20 text-[#3ddc8c] font-bold font-mono flex items-center justify-center shrink-0 text-[11px]\">\n              {envVars.length > 0 ? 5 : 4}\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"font-semibold text-white\">Verify Free SSL &amp; Domain</div>\n              <p className=\"text-white/50 leading-relaxed\">\n                Check <strong>Security \342\206\222 SSL</strong> in hPanel to make sure Let\'s Encrypt SSL is active. Your website is ready for the world!\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-2\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] text-white transition-colors border border-white/10\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Validator</span>\n        </button>\n\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[#5b8cff] hover:bg-[#4a7de8] text-white transition-all shadow-lg shadow-[#5b8cff]/20\"\n        >\n          <span>Open Interactive Live Preview</span>\n          <Eye className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div"
      edit_distance: 8
      rel_edit_distance: 8.341153E-4
      num_matches: 1
      is_non_exact: true
      use_global_match: true
    }
  }
}
