    instruction: "Update RepairView to Bento Grid styling"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Wrench className=\"w-5 h-5 text-[#5b8cff]\" />\n            Hostinger Compatibility Repair Engine\n          </h1>\n          <p className=\"text-xs text-white/50 mt-1\">\n            Automated code adjustments, server configurations, and path normalizations.\n          </p>\n        </div>\n\n        <button\n          onClick={onRunDeepAiRepair}\n          disabled={isAiRepairing}\n          className=\"flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#5b8cff] to-[#7c5cff] hover:opacity-90 text-white disabled:opacity-50 transition-all shadow-md shadow-[#5b8cff]/20\"\n        >\n          {isAiRepairing ? (\n            <>\n              <div className=\"w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n              <span>Running Deep Repair...</span>\n            </>\n          ) : (\n            <>\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Run Deep AI Repair Pass</span>\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* Summary KPI Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        <div className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-[#3ddc8c]/15 text-[#3ddc8c] flex items-center justify-center font-mono font-extrabold text-xl\">\n            {fixCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-white/50 font-semibold uppercase tracking-wider font-mono\">\n              Fixes Applied\n            </div>\n            <div className=\"text-sm font-bold text-white\">Auto-configured for Hostinger</div>\n          </div>\n        </div>\n\n        <div className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-[#ffb547]/15 text-[#ffb547] flex items-center justify-center font-mono font-extrabold text-xl\">\n            {warnCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-white/50 font-semibold uppercase tracking-wider font-mono\">\n              Review Items\n            </div>\n            <div className=\"text-sm font-bold text-white\">Advisories & Key Settings</div>\n          </div>\n        </div>\n\n        <div className=\"p-4 rounded-2xl bg-[#12121c] border border-white/10 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-[#5b8cff]/15 text-[#5b8cff] flex items-center justify-center font-mono font-extrabold text-xl\">\n            {infoCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-white/50 font-semibold uppercase tracking-wider font-mono\">\n              Deployment Info\n            </div>\n            <div className=\"text-sm font-bold text-white\">Runtime & Structure Notes</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Category Filter Tabs */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 border-b border-white/10 text-xs\">\n        {categories.map((cat) => (\n          <button\n            key={cat.id}\n            onClick={() => setActiveCategory(cat.id)}\n            className={`px-3.5 py-1.5 rounded-lg font-medium whitespace-nowrap transition-all ${\n              activeCategory === cat.id\n                ? \'bg-white/10 text-white font-semibold\'\n                : \'text-white/50 hover:text-white hover:bg-white/5\'\n            }`}\n          >\n            {cat.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Fixes List */}\n      <div className=\"space-y-3\">\n        {filteredFixes.length === 0 ? (\n          <div className=\"p-8 text-center rounded-2xl bg-[#12121c] border border-white/10 text-white/40 text-xs\">\n            No fixes found in this category.\n          </div>\n        ) : (\n          filteredFixes.map((fix) => {\n            const isExpanded = expandedFixId === fix.id;\n            return (\n              <div\n                key={fix.id}\n                className={`rounded-2xl border transition-all overflow-hidden ${\n                  fix.type === \'fix\'\n                    ? \'bg-[#12121c] border-[#3ddc8c]/20\'\n                    : fix.type === \'warn\'\n                    ? \'bg-[#141210] border-[#ffb547]/30\'\n                    : \'bg-[#12121c] border-white/10\'\n                }`}\n              >\n                {/* Fix Item Row */}\n                <div\n                  onClick={() => setExpandedFixId(isExpanded ? null : fix.id)}\n                  className=\"p-4 flex items-center justify-between gap-4 cursor-pointer select-none hover:bg-white/[0.02]\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <span\n                      className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 ${\n                        fix.type === \'fix\'\n                          ? \'bg-[#3ddc8c]/20 text-[#3ddc8c]\'\n                          : fix.type === \'warn\'\n                          ? \'bg-[#ffb547]/20 text-[#ffb547]\'\n                          : \'bg-[#5b8cff]/20 text-[#5b8cff]\'\n                      }`}\n                    >\n                      {fix.type === \'fix\' ? (\n                        <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n                      ) : fix.type === \'warn\' ? (\n                        <AlertTriangle className=\"w-3.5 h-3.5\" />\n                      ) : (\n                        <Info className=\"w-3.5 h-3.5\" />\n                      )}\n                    </span>\n\n                    <div className=\"min-w-0\">\n                      <div className=\"font-semibold text-xs text-white truncate flex items-center gap-2\">\n                        <span>{fix.msg}</span>\n                        {fix.targetFile && (\n                          <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-white/50 border border-white/10\">\n                            {fix.targetFile}\n                          </span>\n                        )}\n                      </div>\n                      {fix.detail && (\n                        <p className=\"text-[11px] text-white/50 truncate mt-0.5\">{fix.detail}</p>\n                      )}\n                    </div>\n                  </div>\n\n                  <span className=\"text-[10px] font-mono uppercase tracking-wider text-white/40 shrink-0\">\n                    {fix.category}\n                  </span>\n                </div>\n\n                {/* Expanded Diff / Code Details */}\n                {isExpanded && (\n                  <div className=\"p-4 pt-0 border-t border-white/5 space-y-3 bg-black/30\">\n                    {fix.detail && (\n                      <p className=\"text-xs text-white/70 leading-relaxed\">{fix.detail}</p>\n                    )}\n\n                    {fix.diff && (\n                      <div className=\"rounded-xl bg-[#09090e] border border-white/10 p-3 font-mono text-xs overflow-x-auto\">\n                        <div className=\"text-[10px] uppercase font-bold text-[#5b8cff] mb-1.5 flex items-center gap-1.5\">\n                          <FileCode className=\"w-3 h-3\" />\n                          Generated / Updated Content:\n                        </div>\n                        <pre className=\"text-[#9ee5bd] text-[11px] whitespace-pre leading-relaxed\">\n                          {fix.diff.after}\n                        </pre>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            );\n          })\n        )}\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-4 border-t border-white/10\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] text-white transition-colors border border-white/10\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Analysis</span>\n        </button>\n\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[#5b8cff] hover:bg-[#4a7de8] text-white transition-all shadow-lg shadow-[#5b8cff]/20\"\n        >\n          <span>Continue to Build Config</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-800\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Wrench className=\"w-5 h-5 text-indigo-400\" />\n            Hostinger Compatibility Repair Engine\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Automated code adjustments, server configurations, and path normalizations.\n          </p>\n        </div>\n\n        <button\n          onClick={onRunDeepAiRepair}\n          disabled={isAiRepairing}\n          className=\"flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-indigo-600 to-violet-600 hover:opacity-95 text-white disabled:opacity-50 transition-all shadow-md shadow-indigo-600/20\"\n        >\n          {isAiRepairing ? (\n            <>\n              <div className=\"w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n              <span>Running Deep Repair...</span>\n            </>\n          ) : (\n            <>\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Run Deep AI Repair Pass</span>\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* Bento Summary KPI Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        <div className=\"p-5 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 flex items-center gap-4 shadow-sm\">\n          <div className=\"w-12 h-12 rounded-2xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center font-mono font-extrabold text-xl border border-emerald-500/20\">\n            {fixCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-slate-400 font-semibold uppercase tracking-wider font-mono\">\n              Fixes Applied\n            </div>\n            <div className=\"text-sm font-bold text-white\">Auto-configured for Hostinger</div>\n          </div>\n        </div>\n\n        <div className=\"p-5 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 flex items-center gap-4 shadow-sm\">\n          <div className=\"w-12 h-12 rounded-2xl bg-amber-500/15 text-amber-400 flex items-center justify-center font-mono font-extrabold text-xl border border-amber-500/20\">\n            {warnCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-slate-400 font-semibold uppercase tracking-wider font-mono\">\n              Review Items\n            </div>\n            <div className=\"text-sm font-bold text-white\">Advisories & Key Settings</div>\n          </div>\n        </div>\n\n        <div className=\"p-5 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 flex items-center gap-4 shadow-sm\">\n          <div className=\"w-12 h-12 rounded-2xl bg-indigo-500/15 text-indigo-400 flex items-center justify-center font-mono font-extrabold text-xl border border-indigo-500/20\">\n            {infoCount}\n          </div>\n          <div>\n            <div className=\"text-xs text-slate-400 font-semibold uppercase tracking-wider font-mono\">\n              Deployment Info\n            </div>\n            <div className=\"text-sm font-bold text-white\">Runtime & Structure Notes</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Category Filter Tabs */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 border-b border-slate-800 text-xs\">\n        {categories.map((cat) => (\n          <button\n            key={cat.id}\n            onClick={() => setActiveCategory(cat.id)}\n            className={`px-3.5 py-1.5 rounded-xl font-medium whitespace-nowrap transition-all ${\n              activeCategory === cat.id\n                ? \'bg-slate-800 text-white font-semibold shadow-sm\'\n                : \'text-slate-400 hover:text-white hover:bg-slate-900\'\n            }`}\n          >\n            {cat.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Fixes List in Bento Containers */}\n      <div className=\"space-y-3\">\n        {filteredFixes.length === 0 ? (\n          <div className=\"p-8 text-center rounded-3xl bg-slate-900/60 border border-slate-800 text-slate-400 text-xs shadow-sm\">\n            No fixes found in this category.\n          </div>\n        ) : (\n          filteredFixes.map((fix) => {\n            const isExpanded = expandedFixId === fix.id;\n            return (\n              <div\n                key={fix.id}\n                className={`rounded-2xl border transition-all overflow-hidden shadow-sm ${\n                  fix.type === \'fix\'\n                    ? \'bg-slate-900/60 border-emerald-500/20\'\n                    : fix.type === \'warn\'\n                    ? \'bg-slate-900/60 border-amber-500/30\'\n                    : \'bg-slate-900/60 border-slate-800\'\n                }`}\n              >\n                {/* Fix Item Row */}\n                <div\n                  onClick={() => setExpandedFixId(isExpanded ? null : fix.id)}\n                  className=\"p-4 flex items-center justify-between gap-4 cursor-pointer select-none hover:bg-slate-800/30 transition-colors\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <span\n                      className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 ${\n                        fix.type === \'fix\'\n                          ? \'bg-emerald-500/20 text-emerald-400\'\n                          : fix.type === \'warn\'\n                          ? \'bg-amber-500/20 text-amber-400\'\n                          : \'bg-indigo-500/20 text-indigo-400\'\n                      }`}\n                    >\n                      {fix.type === \'fix\' ? (\n                        <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n                      ) : fix.type === \'warn\' ? (\n                        <AlertTriangle className=\"w-3.5 h-3.5\" />\n                      ) : (\n                        <Info className=\"w-3.5 h-3.5\" />\n                      )}\n                    </span>\n\n                    <div className=\"min-w-0\">\n                      <div className=\"font-semibold text-xs text-white truncate flex items-center gap-2\">\n                        <span>{fix.msg}</span>\n                        {fix.targetFile && (\n                          <span className=\"text-[10px] font-mono px-2 py-0.5 rounded-md bg-slate-950 text-slate-400 border border-slate-800\">\n                            {fix.targetFile}\n                          </span>\n                        )}\n                      </div>\n                      {fix.detail && (\n                        <p className=\"text-[11px] text-slate-400 truncate mt-0.5\">{fix.detail}</p>\n                      )}\n                    </div>\n                  </div>\n\n                  <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-400 shrink-0\">\n                    {fix.category}\n                  </span>\n                </div>\n\n                {/* Expanded Diff / Code Details */}\n                {isExpanded && (\n                  <div className=\"p-4 pt-0 border-t border-slate-800 space-y-3 bg-slate-950/60\">\n                    {fix.detail && (\n                      <p className=\"text-xs text-slate-300 leading-relaxed\">{fix.detail}</p>\n                    )}\n\n                    {fix.diff && (\n                      <div className=\"rounded-xl bg-slate-950 border border-slate-800 p-3.5 font-mono text-xs overflow-x-auto\">\n                        <div className=\"text-[10px] uppercase font-bold text-indigo-400 mb-1.5 flex items-center gap-1.5\">\n                          <FileCode className=\"w-3 h-3\" />\n                          Generated / Updated Content:\n                        </div>\n                        <pre className=\"text-emerald-300 text-[11px] whitespace-pre leading-relaxed\">\n                          {fix.diff.after}\n                        </pre>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            );\n          })\n        )}\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-4 border-t border-slate-800\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 transition-colors border border-slate-700/60 shadow-sm\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Analysis</span>\n        </button>\n\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-lg shadow-indigo-600/25\"\n        >\n          <span>Continue to Build Config</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
