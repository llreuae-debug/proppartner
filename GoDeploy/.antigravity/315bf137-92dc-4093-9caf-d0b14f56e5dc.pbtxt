  file_change {
    absolute_path_uri: "file:///src/components/GitHubRepoSelector.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport {\n  Search,\n  Lock,\n  Globe,\n  Star,\n  GitFork,\n  GitBranch,\n  Folder,\n  ArrowRight,\n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n  RefreshCw,\n  LogOut,\n  SlidersHorizontal,\n  FolderGit2,\n  CheckCircle2,\n  Code2,\n  Calendar,\n  Sparkles,\n} from \'lucide-react\';\nimport { GitHubUserProfile, GitHubUserRepoItem } from \'../utils/github\';\n\ninterface GitHubRepoSelectorProps {\n  userProfile: GitHubUserProfile | null;\n  repos: GitHubUserRepoItem[];\n  token: string;\n  authType?: \'oauth\' | \'pat\' | null;\n  isLoadingRepos: boolean;\n  onRefreshRepos: () => void;\n  onDisconnect: () => void;\n  onSelectRepo: (repoFullName: string, branch?: string, subpath?: string) => Promise<void>;\n  isImporting: boolean;\n  importingRepoName: string | null;\n  importStatusStep?: string;\n}\n\ntype VisibilityFilter = \'all\' | \'private\' | \'public\';\ntype SortKey = \'updated\' | \'stars\' | \'name\' | \'forks\';\n\nexport const GitHubRepoSelector: React.FC<GitHubRepoSelectorProps> = ({\n  userProfile,\n  repos,\n  token,\n  authType = \'oauth\',\n  isLoadingRepos,\n  onRefreshRepos,\n  onDisconnect,\n  onSelectRepo,\n  isImporting,\n  importingRepoName,\n  importStatusStep,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [visibilityFilter, setVisibilityFilter] = useState<VisibilityFilter>(\'all\');\n  const [languageFilter, setLanguageFilter] = useState<string>(\'all\');\n  const [sortBy, setSortBy] = useState<SortKey>(\'updated\');\n\n  // Expanded options state per repo (custom branch & subfolder)\n  const [expandedRepoId, setExpandedRepoId] = useState<number | null>(null);\n  const [customBranches, setCustomBranches] = useState<Record<number, string>>({});\n  const [customSubpaths, setCustomSubpaths] = useState<Record<number, string>>({});\n\n  // Extract unique languages\n  const availableLanguages = useMemo(() => {\n    const langs = new Set<string>();\n    repos.forEach((r) => {\n      if (r.language && r.language.trim()) {\n        langs.add(r.language.trim());\n      }\n    });\n    return Array.from(langs).sort();\n  }, [repos]);\n\n  // Filter and sort repositories\n  const filteredRepos = useMemo(() => {\n    return repos\n      .filter((repo) => {\n        // Visibility\n        if (visibilityFilter === \'private\' && !repo.private) return false;\n        if (visibilityFilter === \'public\' && repo.private) return false;\n\n        // Language\n        if (languageFilter !== \'all\' && repo.language !== languageFilter) return false;\n\n        // Search Query\n        if (searchQuery.trim()) {\n          const q = searchQuery.toLowerCase();\n          const matchName = repo.name.toLowerCase().includes(q) || repo.full_name.toLowerCase().includes(q);\n          const matchDesc = repo.description && repo.description.toLowerCase().includes(q);\n          const matchLang = repo.language && repo.language.toLowerCase().includes(q);\n          if (!matchName && !matchDesc && !matchLang) return false;\n        }\n\n        return true;\n      })\n      .sort((a, b) => {\n        if (sortBy === \'stars\') {\n          return b.stars - a.stars;\n        }\n        if (sortBy === \'name\') {\n          return a.name.localeCompare(b.name);\n        }\n        if (sortBy === \'forks\') {\n          return b.forks - a.forks;\n        }\n        // Default \'updated\'\n        return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime();\n      });\n  }, [repos, visibilityFilter, languageFilter, searchQuery, sortBy]);\n\n  const privateCount = useMemo(() => repos.filter((r) => r.private).length, [repos]);\n  const publicCount = useMemo(() => repos.filter((r) => !r.private).length, [repos]);\n\n  const handlePullRepo = (repo: GitHubUserRepoItem) => {\n    const selectedBranch = customBranches[repo.id]?.trim() || repo.default_branch || undefined;\n    const selectedSubpath = customSubpaths[repo.id]?.trim() || undefined;\n    onSelectRepo(repo.full_name, selectedBranch, selectedSubpath);\n  };\n\n  const getLanguageColor = (lang: string) => {\n    const map: Record<string, string> = {\n      TypeScript: \'bg-blue-500\',\n      JavaScript: \'bg-amber-400\',\n      HTML: \'bg-orange-500\',\n      CSS: \'bg-sky-500\',\n      Vue: \'bg-emerald-500\',\n      PHP: \'bg-indigo-400\',\n      Python: \'bg-yellow-500\',\n      Rust: \'bg-amber-600\',\n      Go: \'bg-cyan-500\',\n    };\n    return map[lang] || \'bg-slate-400\';\n  };\n\n  const formatRelativeTime = (isoString: string) => {\n    try {\n      const date = new Date(isoString);\n      const now = new Date();\n      const diffSec = Math.floor((now.getTime() - date.getTime()) / 1000);\n      if (diffSec < 60) return \'just now\';\n      if (diffSec < 3600) return `${Math.floor(diffSec / 60)}m ago`;\n      if (diffSec < 86400) return `${Math.floor(diffSec / 3600)}h ago`;\n      if (diffSec < 2592000) return `${Math.floor(diffSec / 86400)}d ago`;\n      return date.toLocaleDateString();\n    } catch {\n      return \'\';\n    }\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      {/* 1. Account Header Banner */}\n      <div className=\"p-5 rounded-3xl bg-slate-900/80 backdrop-blur-md border border-slate-800/90 shadow-sm relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none\" />\n        \n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10\">\n          <div className=\"flex items-center gap-3.5\">\n            {userProfile?.avatar_url ? (\n              <img\n                src={userProfile.avatar_url}\n                alt={userProfile.login}\n                className=\"w-12 h-12 rounded-2xl border-2 border-indigo-500/60 object-cover shadow-md shrink-0\"\n              />\n            ) : (\n              <div className=\"w-12 h-12 rounded-2xl bg-indigo-600/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 shrink-0\">\n                <FolderGit2 className=\"w-6 h-6\" />\n              </div>\n            )}\n\n            <div>\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <span className=\"font-bold text-sm text-white\">\n                  {userProfile?.name || userProfile?.login || \'Authenticated GitHub User\'}\n                </span>\n                <span className=\"text-xs text-slate-400 font-mono\">\n                  @{userProfile?.login || \'github\'}\n                </span>\n                <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                  <CheckCircle2 className=\"w-3 h-3\" />\n                  {authType === \'oauth\' ? \'OAuth Session Active\' : \'PAT Token Active\'}\n                </span>\n              </div>\n\n              <div className=\"flex items-center gap-3 text-xs text-slate-400 mt-1\">\n                <span className=\"flex items-center gap-1 text-amber-400\">\n                  <Lock className=\"w-3 h-3\" /> {privateCount} Private\n                </span>\n                <span>\342\200\242</span>\n                <span className=\"flex items-center gap-1 text-sky-400\">\n                  <Globe className=\"w-3 h-3\" /> {publicCount} Public\n                </span>\n                <span>\342\200\242</span>\n                <span>{repos.length} total repositories</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Actions */}\n          <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n            <button\n              type=\"button\"\n              onClick={onRefreshRepos}\n              disabled={isLoadingRepos}\n              title=\"Refresh Repositories\"\n              className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-950/80 hover:bg-slate-800 border border-slate-800 text-slate-200 transition-colors shadow-sm cursor-pointer\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isLoadingRepos ? \'animate-spin text-indigo-400\' : \'\'}`} />\n              <span>Refresh</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onDisconnect}\n              className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-950/80 hover:bg-rose-950/40 border border-slate-800 hover:border-rose-700/50 text-slate-300 hover:text-rose-300 transition-colors shadow-sm cursor-pointer\"\n            >\n              <LogOut className=\"w-3.5 h-3.5\" />\n              <span>Disconnect</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Repository Browser & Filter Bar */}\n      <div className=\"p-5 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm space-y-4\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-3\">\n          <div>\n            <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n              <FolderGit2 className=\"w-4 h-4 text-indigo-400\" />\n              <span>Select a Repository to Pull into GoDeploy</span>\n            </h2>\n            <p className=\"text-xs text-slate-400 mt-0.5\">\n              Choose any project from your GitHub account to analyze, optimize for Hostinger, and prepare for one-click deployment.\n            </p>\n          </div>\n\n          {/* Visibility Tabs */}\n          <div className=\"flex items-center gap-1 bg-slate-950 p-1 rounded-2xl border border-slate-800 text-xs shrink-0\">\n            <button\n              type=\"button\"\n              onClick={() => setVisibilityFilter(\'all\')}\n              className={`px-3 py-1.5 rounded-xl font-semibold transition-all cursor-pointer ${\n                visibilityFilter === \'all\'\n                  ? \'bg-indigo-600 text-white shadow-sm shadow-indigo-600/20\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              All ({repos.length})\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setVisibilityFilter(\'private\')}\n              className={`px-3 py-1.5 rounded-xl font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                visibilityFilter === \'private\'\n                  ? \'bg-indigo-600 text-white shadow-sm shadow-indigo-600/20\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Lock className=\"w-3 h-3 text-amber-400\" />\n              Private ({privateCount})\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setVisibilityFilter(\'public\')}\n              className={`px-3 py-1.5 rounded-xl font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                visibilityFilter === \'public\'\n                  ? \'bg-indigo-600 text-white shadow-sm shadow-indigo-600/20\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <Globe className=\"w-3 h-3 text-sky-400\" />\n              Public ({publicCount})\n            </button>\n          </div>\n        </div>\n\n        {/* Search & Sort Controls */}\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-2.5\">\n          {/* Search bar (span 6) */}\n          <div className=\"md:col-span-6 relative\">\n            <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Search repositories by name, topic, or description...\"\n              className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono shadow-inner\"\n            />\n            {searchQuery && (\n              <button\n                type=\"button\"\n                onClick={() => setSearchQuery(\'\')}\n                className=\"absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-500 hover:text-slate-300\"\n              >\n                \342\234\225\n              </button>\n            )}\n          </div>\n\n          {/* Language filter (span 3) */}\n          <div className=\"md:col-span-3\">\n            <select\n              value={languageFilter}\n              onChange={(e) => setLanguageFilter(e.target.value)}\n              className=\"w-full px-3 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300 focus:outline-none focus:border-indigo-500 cursor-pointer\"\n            >\n              <option value=\"all\">All Languages</option>\n              {availableLanguages.map((lang) => (\n                <option key={lang} value={lang}>\n                  {lang}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Sort selector (span 3) */}\n          <div className=\"md:col-span-3\">\n            <select\n              value={sortBy}\n              onChange={(e) => setSortBy(e.target.value as SortKey)}\n              className=\"w-full px-3 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300 focus:outline-none focus:border-indigo-500 cursor-pointer\"\n            >\n              <option value=\"updated\">Recently Updated</option>\n              <option value=\"stars\">Most Stars</option>\n              <option value=\"name\">Name (A-Z)</option>\n              <option value=\"forks\">Most Forks</option>\n            </select>\n          </div>\n        </div>\n\n        {/* 3. Repository Cards List */}\n        {isLoadingRepos ? (\n          <div className=\"py-12 text-center text-xs text-slate-400 space-y-3\">\n            <div className=\"w-8 h-8 border-2 border-indigo-500 border-t-transparent rounded-full animate-spin mx-auto\" />\n            <div className=\"font-medium text-slate-300\">Fetching your GitHub repositories...</div>\n            <p className=\"text-[11px] text-slate-500\">Querying user profile and organizational affiliations</p>\n          </div>\n        ) : filteredRepos.length > 0 ? (\n          <div className=\"space-y-3 max-h-[480px] overflow-y-auto pr-1 custom-scrollbar\">\n            {filteredRepos.map((repo) => {\n              const isThisImporting = isImporting && importingRepoName === repo.full_name;\n              const isExpanded = expandedRepoId === repo.id;\n              const curBranch = customBranches[repo.id] !== undefined ? customBranches[repo.id] : repo.default_branch;\n              const curSubpath = customSubpaths[repo.id] || \'\';\n\n              return (\n                <div\n                  key={repo.id}\n                  className={`p-4 rounded-2xl border transition-all duration-200 ${\n                    isThisImporting\n                      ? \'bg-indigo-950/40 border-indigo-500/80 shadow-lg shadow-indigo-500/10 ring-1 ring-indigo-500\'\n                      : \'bg-slate-950/60 hover:bg-slate-950 border-slate-800/80 hover:border-slate-700\'\n                  }`}\n                >\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    {/* Left: Info */}\n                    <div className=\"min-w-0 flex-1 space-y-1.5\">\n                      <div className=\"flex items-center gap-2 flex-wrap\">\n                        {repo.private ? (\n                          <span\n                            className=\"p-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 shrink-0\"\n                            title=\"Private Repository\"\n                          >\n                            <Lock className=\"w-3.5 h-3.5\" />\n                          </span>\n                        ) : (\n                          <span\n                            className=\"p-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20 shrink-0\"\n                            title=\"Public Repository\"\n                          >\n                            <Globe className=\"w-3.5 h-3.5\" />\n                          </span>\n                        )}\n\n                        <span className=\"font-bold text-sm text-white hover:text-indigo-300 transition-colors truncate\">\n                          {repo.full_name}\n                        </span>\n\n                        {repo.language && (\n                          <span className=\"inline-flex items-center gap-1.5 text-[11px] font-mono px-2 py-0.5 rounded-full bg-slate-900 border border-slate-800 text-slate-300\">\n                            <span className={`w-2 h-2 rounded-full ${getLanguageColor(repo.language)}`} />\n                            {repo.language}\n                          </span>\n                        )}\n\n                        <a\n                          href={repo.html_url}\n                          target=\"_blank\"\n                          rel=\"noreferrer\"\n                          className=\"text-slate-500 hover:text-slate-300 p-0.5 transition-colors\"\n                          title=\"Open repository on GitHub\"\n                        >\n                          <ExternalLink className=\"w-3 h-3\" />\n                        </a>\n                      </div>\n\n                      {repo.description ? (\n                        <p className=\"text-xs text-slate-400 line-clamp-2 leading-relaxed\">\n                          {repo.description}\n                        </p>\n                      ) : (\n                        <p className=\"text-xs text-slate-600 italic\">No description provided.</p>\n                      )}\n\n                      {/* Meta Tags */}\n                      <div className=\"flex items-center gap-3.5 text-[11px] text-slate-500 font-mono flex-wrap pt-0.5\">\n                        <span className=\"flex items-center gap-1 text-slate-400\">\n                          <GitBranch className=\"w-3 h-3 text-indigo-400\" />\n                          <span>{curBranch || repo.default_branch}</span>\n                        </span>\n\n                        {repo.stars > 0 && (\n                          <span className=\"flex items-center gap-1 text-amber-400/90\">\n                            <Star className=\"w-3 h-3 fill-amber-400/90\" /> {repo.stars}\n                          </span>\n                        )}\n\n                        {repo.forks > 0 && (\n                          <span className=\"flex items-center gap-1 text-slate-400\">\n                            <GitFork className=\"w-3 h-3\" /> {repo.forks}\n                          </span>\n                        )}\n\n                        <span className=\"flex items-center gap-1 text-slate-500\">\n                          <Calendar className=\"w-3 h-3\" />\n                          <span>{formatRelativeTime(repo.updated_at)}</span>\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Right: Actions */}\n                    <div className=\"flex items-center gap-2 shrink-0 self-end sm:self-center\">\n                      <button\n                        type=\"button\"\n                        onClick={() => setExpandedRepoId(isExpanded ? null : repo.id)}\n                        className={`p-2 rounded-xl text-xs font-semibold border transition-all cursor-pointer flex items-center gap-1 ${\n                          isExpanded\n                            ? \'bg-slate-800 text-white border-slate-700\'\n                            : \'bg-slate-900/80 text-slate-400 hover:text-white border-slate-800 hover:border-slate-700\'\n                        }`}\n                        title=\"Customize branch or subfolder\"\n                      >\n                        <SlidersHorizontal className=\"w-3.5 h-3.5\" />\n                        {isExpanded ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n                      </button>\n\n                      <button\n                        type=\"button\"\n                        disabled={isImporting}\n                        onClick={() => handlePullRepo(repo)}\n                        className=\"px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-50 transition-all flex items-center gap-2 shadow-md shadow-indigo-600/25 cursor-pointer\"\n                      >\n                        {isThisImporting ? (\n                          <>\n                            <div className=\"w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                            <span>{importStatusStep || \'Pulling...\'}</span>\n                          </>\n                        ) : (\n                          <>\n                            <span>Pull into GoDeploy</span>\n                            <ArrowRight className=\"w-3.5 h-3.5\" />\n                          </>\n                        )}\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* Expandable Advanced Options per Repo */}\n                  {isExpanded && (\n                    <div className=\"mt-3.5 pt-3.5 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-3 animate-in fade-in duration-150\">\n                      <div>\n                        <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5\">\n                          <GitBranch className=\"w-3 h-3 text-indigo-400\" />\n                          Target Branch / Tag\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={curBranch}\n                          onChange={(e) =>\n                            setCustomBranches((prev) => ({ ...prev, [repo.id]: e.target.value }))\n                          }\n                          placeholder={repo.default_branch || \'main\'}\n                          className=\"w-full px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                        />\n                      </div>\n\n                      <div>\n                        <label className=\"block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5\">\n                          <Folder className=\"w-3 h-3 text-indigo-400\" />\n                          Subfolder Path (Monorepo)\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={curSubpath}\n                          onChange={(e) =>\n                            setCustomSubpaths((prev) => ({ ...prev, [repo.id]: e.target.value }))\n                          }\n                          placeholder=\"e.g. client, frontend, or packages/app\"\n                          className=\"w-full px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono\"\n                        />\n                      </div>\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        ) : (\n          <div className=\"py-10 text-center text-xs text-slate-400 space-y-2 bg-slate-950/40 rounded-2xl border border-slate-800/60 p-6\">\n            <div className=\"w-8 h-8 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-500 mx-auto\">\n              <Search className=\"w-4 h-4\" />\n            </div>\n            <div className=\"font-semibold text-slate-300\">No repositories found</div>\n            <p className=\"text-slate-500 max-w-sm mx-auto\">\n              No repositories matched your current query or filter criteria. Try clearing the search or changing the filter.\n            </p>\n            <button\n              type=\"button\"\n              onClick={() => {\n                setSearchQuery(\'\');\n                setVisibilityFilter(\'all\');\n                setLanguageFilter(\'all\');\n              }}\n              className=\"mt-2 px-3 py-1.5 rounded-xl bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 font-semibold cursor-pointer\"\n            >\n              Reset Filters\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
