    replacement_chunks {
      target_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Page Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Activity className=\"w-5 h-5 text-[#5b8cff]\" />\n            Project Analysis & Architecture\n          </h1>\n          <p className=\"text-xs text-white/50 mt-1\">\n            Source: <span className=\"font-mono text-white/80\">{project.name}</span> ({project.source}) \342\200\242{\' \'}\n            {project.fileCount} files scanned\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={onOpenInspector}\n            className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-white transition-colors\"\n          >\n            <FileSearch className=\"w-4 h-4 text-[#5b8cff]\" />\n            <span>Browse Files</span>\n          </button>\n\n          <button\n            onClick={onRunAiAudit}\n            className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-[#5b8cff]/20 to-[#7c5cff]/20 hover:from-[#5b8cff]/30 hover:to-[#7c5cff]/30 border border-[#7c5cff]/40 text-[#c5d3ff] transition-all\"\n          >\n            <Sparkles className=\"w-4 h-4 text-[#7c5cff]\" />\n            <span>AI Deep Audit</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Score & Summary Card */}\n      <div className=\"p-6 rounded-2xl bg-[#12121c] border border-white/10\">\n        <div className=\"flex flex-col md:flex-row items-center gap-8\">\n          {/* Radial Score Gauge */}\n          <div className=\"relative w-36 h-36 flex items-center justify-center shrink-0\">\n            <svg className=\"w-full h-full transform -rotate-90\">\n              <circle\n                cx=\"72\"\n                cy=\"72\"\n                r={radius}\n                className=\"stroke-white/10 fill-none\"\n                strokeWidth=\"10\"\n              />\n              <circle\n                cx=\"72\"\n                cy=\"72\"\n                r={radius}\n                className=\"stroke-[#5b8cff] fill-none transition-all duration-1000 ease-out\"\n                strokeWidth=\"10\"\n                strokeDasharray={circumference}\n                strokeDashoffset={strokeDashoffset}\n                strokeLinecap=\"round\"\n              />\n            </svg>\n            <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n              <span className=\"text-3xl font-black text-white font-mono tracking-tight\">\n                {analysis.score}%\n              </span>\n              <span className=\"text-[10px] uppercase font-bold text-white/50 tracking-wider\">\n                Hostinger Fit\n              </span>\n            </div>\n          </div>\n\n          {/* Architecture Summary Details */}\n          <div className=\"flex-1 w-full grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n            <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between\">\n              <span className=\"text-white/50\">Framework:</span>\n              <span className=\"font-semibold text-white font-mono\">{analysis.framework}</span>\n            </div>\n\n            <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between\">\n              <span className=\"text-white/50\">Primary Languages:</span>\n              <span className=\"font-semibold text-white font-mono\">\n                {analysis.language.join(\', \') || \'N/A\'}\n              </span>\n            </div>\n\n            <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between\">\n              <span className=\"text-white/50\">Package Manager:</span>\n              <span className=\"font-semibold text-white font-mono\">{analysis.packageManager || \'None\'}</span>\n            </div>\n\n            <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between\">\n              <span className=\"text-white/50\">Entry Point:</span>\n              <span className=\"font-semibold text-white font-mono truncate max-w-[160px]\">\n                {analysis.entryPoint || \'index.html\'}\n              </span>\n            </div>\n\n            <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between\">\n              <span className=\"text-white/50\">Build Status:</span>\n              <span\n                className={`font-semibold font-mono ${\n                  analysis.hasBuildOutput ? \'text-[#3ddc8c]\' : \'text-[#ffb547]\'\n                }`}\n              >\n                {analysis.hasBuildOutput ? `Output: ${analysis.buildOutputDir}` : \'Raw Source Code\'}\n              </span>\n            </div>\n\n            <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between\">\n              <span className=\"text-white/50\">Routing Archetype:</span>\n              <span className=\"font-semibold text-white font-mono truncate max-w-[160px]\">\n                {analysis.routing}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Compatibility Matrix */}\n      <div className=\"p-6 rounded-2xl bg-[#12121c] border border-white/10 space-y-4\">\n        <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n          <Layers className=\"w-4 h-4 text-[#5b8cff]\" />\n          Hostinger Compatibility Matrix\n        </h2>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3\">\n          {compatMatrix.map((item, idx) => (\n            <div\n              key={idx}\n              className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 flex flex-col justify-between gap-2\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-semibold text-xs text-white/90\">{item.label}</span>\n                {item.status === \'ok\' ? (\n                  <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#3ddc8c]/15 text-[#3ddc8c] border border-[#3ddc8c]/30\">\n                    READY\n                  </span>\n                ) : item.status === \'warn\' ? (\n                  <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#ffb547]/15 text-[#ffb547] border border-[#ffb547]/30\">\n                    REVIEW\n                  </span>\n                ) : (\n                  <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#ff5d6c]/15 text-[#ff5d6c] border border-[#ff5d6c]/30\">\n                    ACTION\n                  </span>\n                )}\n              </div>\n              <p className=\"text-[11px] text-white/50 leading-relaxed truncate\">{item.desc}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Two-Column Details Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-5\">\n        {/* Environment Variables Card */}\n        <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10 flex flex-col\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2\">\n              <KeyRound className=\"w-3.5 h-3.5 text-[#5b8cff]\" />\n              Detected Environment Variables ({analysis.environmentVariables.length})\n            </h3>\n          </div>\n\n          <div className=\"flex-1\">\n            {analysis.environmentVariables.length > 0 ? (\n              <div className=\"flex flex-wrap gap-1.5 max-h-48 overflow-y-auto\">\n                {analysis.environmentVariables.map((env, i) => (\n                  <span\n                    key={i}\n                    className=\"px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/10 font-mono text-[11px] text-[#9bb8ff]\"\n                  >\n                    {env}\n                  </span>\n                ))}\n              </div>\n            ) : (\n              <div className=\"py-6 text-center text-xs text-white/40\">\n                No environment variables detected in client or server code.\n              </div>\n            )}\n          </div>\n          <p className=\"text-[11px] text-white/40 mt-3 pt-3 border-t border-white/5\">\n            WEBSITE2HOST will generate a safe <code className=\"text-white font-mono\">.env.example</code> for Hostinger configuration.\n          </p>\n        </div>\n\n        {/* Database & External Services */}\n        <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10 flex flex-col\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2\">\n              <Database className=\"w-3.5 h-3.5 text-[#7c5cff]\" />\n              Database & External Integrations\n            </h3>\n          </div>\n\n          <div className=\"flex-1 space-y-2\">\n            <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between text-xs\">\n              <span className=\"text-white/60\">Database / ORM:</span>\n              <span className=\"font-semibold text-white font-mono\">\n                {analysis.database || \'None detected\'}\n              </span>\n            </div>\n\n            {analysis.externalServices.length > 0 && (\n              <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 text-xs\">\n                <div className=\"text-white/60 mb-1.5\">Third-Party Services:</div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {analysis.externalServices.map((svc, i) => (\n                    <span\n                      key={i}\n                      className=\"px-2 py-0.5 rounded-md bg-[#5b8cff]/10 text-[#9bb8ff] font-mono text-[11px]\"\n                    >\n                      {svc}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {analysis.paymentIntegrations.length > 0 && (\n              <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 text-xs\">\n                <div className=\"text-white/60 mb-1.5\">Payment Gateways:</div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {analysis.paymentIntegrations.map((pay, i) => (\n                    <span\n                      key={i}\n                      className=\"px-2 py-0.5 rounded-md bg-[#ffb547]/10 text-[#ffb547] font-mono text-[11px]\"\n                    >\n                      {pay}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Action Bar */}\n      <div className=\"flex items-center justify-end gap-3 pt-2\">\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-[#5b8cff] hover:bg-[#4a7de8] text-white transition-all shadow-lg shadow-[#5b8cff]/20\"\n        >\n          <span>Continue to Repair Engine</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Page Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-800\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Activity className=\"w-5 h-5 text-indigo-400\" />\n            Project Analysis &amp; Architecture\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Source: <span className=\"font-mono text-slate-200\">{project.name}</span> ({project.source}) \342\200\242{\' \'}\n            {project.fileCount} files scanned\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={onOpenInspector}\n            className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/60 text-slate-200 transition-colors shadow-sm\"\n          >\n            <FileSearch className=\"w-4 h-4 text-indigo-400\" />\n            <span>Browse Files</span>\n          </button>\n\n          <button\n            onClick={onRunAiAudit}\n            className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-indigo-500/15 hover:bg-indigo-500/25 border border-indigo-500/30 text-indigo-300 transition-all shadow-sm shadow-indigo-500/10\"\n          >\n            <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n            <span>AI Deep Audit</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Score & Architecture Bento Card */}\n      <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 w-64 h-64 bg-indigo-500/5 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"flex flex-col md:flex-row items-center gap-8 relative z-10\">\n          {/* Radial Score Gauge */}\n          <div className=\"relative w-36 h-36 flex items-center justify-center shrink-0\">\n            <svg className=\"w-full h-full transform -rotate-90\">\n              <circle\n                cx=\"72\"\n                cy=\"72\"\n                r={radius}\n                className=\"stroke-slate-800 fill-none\"\n                strokeWidth=\"10\"\n              />\n              <circle\n                cx=\"72\"\n                cy=\"72\"\n                r={radius}\n                className=\"stroke-indigo-500 fill-none transition-all duration-1000 ease-out\"\n                strokeWidth=\"10\"\n                strokeDasharray={circumference}\n                strokeDashoffset={strokeDashoffset}\n                strokeLinecap=\"round\"\n              />\n            </svg>\n            <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n              <span className=\"text-3xl font-black text-white font-mono tracking-tight\">\n                {analysis.score}%\n              </span>\n              <span className=\"text-[10px] uppercase font-bold text-slate-400 tracking-wider\">\n                Hostinger Fit\n              </span>\n            </div>\n          </div>\n\n          {/* Architecture Summary Details */}\n          <div className=\"flex-1 w-full grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n            <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-slate-400\">Framework:</span>\n              <span className=\"font-semibold text-white font-mono\">{analysis.framework}</span>\n            </div>\n\n            <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-slate-400\">Primary Languages:</span>\n              <span className=\"font-semibold text-white font-mono\">\n                {analysis.language.join(\', \') || \'N/A\'}\n              </span>\n            </div>\n\n            <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-slate-400\">Package Manager:</span>\n              <span className=\"font-semibold text-white font-mono\">{analysis.packageManager || \'None\'}</span>\n            </div>\n\n            <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-slate-400\">Entry Point:</span>\n              <span className=\"font-semibold text-white font-mono truncate max-w-[160px]\">\n                {analysis.entryPoint || \'index.html\'}\n              </span>\n            </div>\n\n            <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-slate-400\">Build Status:</span>\n              <span\n                className={`font-semibold font-mono ${\n                  analysis.hasBuildOutput ? \'text-emerald-400\' : \'text-amber-400\'\n                }`}\n              >\n                {analysis.hasBuildOutput ? `Output: ${analysis.buildOutputDir}` : \'Raw Source Code\'}\n              </span>\n            </div>\n\n            <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-slate-400\">Routing Archetype:</span>\n              <span className=\"font-semibold text-white font-mono truncate max-w-[160px]\">\n                {analysis.routing}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Compatibility Matrix Bento Card */}\n      <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm space-y-4\">\n        <h2 className=\"text-sm font-bold text-white flex items-center gap-2\">\n          <Layers className=\"w-4 h-4 text-indigo-400\" />\n          Hostinger Compatibility Matrix\n        </h2>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3\">\n          {compatMatrix.map((item, idx) => (\n            <div\n              key={idx}\n              className=\"p-4 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex flex-col justify-between gap-2.5 hover:border-slate-700 transition-colors\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-semibold text-xs text-slate-200\">{item.label}</span>\n                {item.status === \'ok\' ? (\n                  <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30\">\n                    READY\n                  </span>\n                ) : item.status === \'warn\' ? (\n                  <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30\">\n                    REVIEW\n                  </span>\n                ) : (\n                  <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/15 text-rose-400 border border-rose-500/30\">\n                    ACTION\n                  </span>\n                )}\n              </div>\n              <p className=\"text-[11px] text-slate-400 leading-relaxed truncate\">{item.desc}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Two-Column Bento Details Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-5\">\n        {/* Environment Variables Card */}\n        <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm flex flex-col\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2\">\n              <KeyRound className=\"w-3.5 h-3.5 text-indigo-400\" />\n              Detected Environment Variables ({analysis.environmentVariables.length})\n            </h3>\n          </div>\n\n          <div className=\"flex-1\">\n            {analysis.environmentVariables.length > 0 ? (\n              <div className=\"flex flex-wrap gap-1.5 max-h-48 overflow-y-auto\">\n                {analysis.environmentVariables.map((env, i) => (\n                  <span\n                    key={i}\n                    className=\"px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800 font-mono text-[11px] text-indigo-300\"\n                  >\n                    {env}\n                  </span>\n                ))}\n              </div>\n            ) : (\n              <div className=\"py-6 text-center text-xs text-slate-500\">\n                No environment variables detected in client or server code.\n              </div>\n            )}\n          </div>\n          <p className=\"text-[11px] text-slate-500 mt-3 pt-3 border-t border-slate-800\">\n            WEBSITE2HOST will generate a safe <code className=\"text-slate-300 font-mono\">.env.example</code> for Hostinger configuration.\n          </p>\n        </div>\n\n        {/* Database & External Services Bento Card */}\n        <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 shadow-sm flex flex-col\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2\">\n              <Database className=\"w-3.5 h-3.5 text-violet-400\" />\n              Database &amp; External Integrations\n            </h3>\n          </div>\n\n          <div className=\"flex-1 space-y-2\">\n            <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 flex items-center justify-between text-xs\">\n              <span className=\"text-slate-400\">Database / ORM:</span>\n              <span className=\"font-semibold text-white font-mono\">\n                {analysis.database || \'None detected\'}\n              </span>\n            </div>\n\n            {analysis.externalServices.length > 0 && (\n              <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 text-xs\">\n                <div className=\"text-slate-400 mb-1.5\">Third-Party Services:</div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {analysis.externalServices.map((svc, i) => (\n                    <span\n                      key={i}\n                      className=\"px-2 py-0.5 rounded-md bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 font-mono text-[11px]\"\n                    >\n                      {svc}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {analysis.paymentIntegrations.length > 0 && (\n              <div className=\"p-3.5 rounded-2xl bg-slate-950/50 border border-slate-800/80 text-xs\">\n                <div className=\"text-slate-400 mb-1.5\">Payment Gateways:</div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {analysis.paymentIntegrations.map((pay, i) => (\n                    <span\n                      key={i}\n                      className=\"px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-300 border border-amber-500/20 font-mono text-[11px]\"\n                    >\n                      {pay}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Action Bar */}\n      <div className=\"flex items-center justify-end gap-3 pt-2\">\n        <button\n          onClick={onNext}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-lg shadow-indigo-600/25\"\n        >\n          <span>Continue to Repair Engine</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );"
