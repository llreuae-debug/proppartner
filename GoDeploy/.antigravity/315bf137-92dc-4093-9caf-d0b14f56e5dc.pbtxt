    replacement_chunks {
      target_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-white/10\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Cpu className=\"w-5 h-5 text-[#5b8cff]\" />\n            Hostinger Build & Packaging Configuration\n          </h1>\n          <p className=\"text-xs text-white/50 mt-1\">\n            Target Hostinger infrastructure: <strong className=\"text-[#9bb8ff] font-mono\">{effectiveMode.toUpperCase()}</strong>\n          </p>\n        </div>\n      </div>\n\n      {/* Deployment Mode Selection */}\n      <div className=\"space-y-3\">\n        <h2 className=\"text-xs font-bold uppercase tracking-wider text-white/60 font-mono\">\n          Select Deployment Target\n        </h2>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n          {modeOptions.map((opt) => {\n            const isSelected = effectiveMode === opt.id;\n            const isRec = recommendedMode === opt.id;\n\n            return (\n              <div\n                key={opt.id}\n                onClick={() => onSelectMode(opt.id)}\n                className={`p-4 rounded-2xl border cursor-pointer transition-all ${\n                  isSelected\n                    ? \'bg-[#5b8cff]/10 border-[#5b8cff] shadow-md shadow-[#5b8cff]/10\'\n                    : \'bg-[#12121c] border-white/10 hover:border-white/20\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between mb-2\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <span className=\"text-xl\">{opt.icon}</span>\n                    <span className=\"font-bold text-xs text-white\">{opt.title}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5\">\n                    {isRec && (\n                      <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#3ddc8c]/15 text-[#3ddc8c] border border-[#3ddc8c]/30\">\n                        RECOMMENDED\n                      </span>\n                    )}\n                    {isSelected && (\n                      <span className=\"w-2 h-2 rounded-full bg-[#5b8cff] animate-pulse\" />\n                    )}\n                  </div>\n                </div>\n                <p className=\"text-[11px] text-white/50 leading-relaxed\">{opt.desc}</p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Environment Variables Table */}\n      <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2\">\n              <KeyRound className=\"w-3.5 h-3.5 text-[#5b8cff]\" />\n              Environment Variables ({envVars.length})\n            </h3>\n            <p className=\"text-[11px] text-white/40 mt-0.5\">\n              These will be structured into <code className=\"text-white font-mono\">.env.example</code> for your Hostinger hPanel setup.\n            </p>\n          </div>\n        </div>\n\n        {envVars.length === 0 ? (\n          <div className=\"py-6 text-center text-xs text-white/40 border border-white/5 rounded-xl bg-white/[0.01]\">\n            No environment variables required for this project.\n          </div>\n        ) : (\n          <div className=\"space-y-2 max-h-60 overflow-y-auto\">\n            {envVars.map((v, idx) => (\n              <div\n                key={v.name}\n                className=\"flex items-center gap-3 p-2.5 rounded-xl bg-white/[0.02] border border-white/5 text-xs font-mono\"\n              >\n                <span className=\"text-[#9bb8ff] font-semibold w-1/3 truncate\">{v.name}</span>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. your-api-key (optional preview value)\"\n                  value={v.value}\n                  onChange={(e) => onUpdateEnvVar(idx, e.target.value)}\n                  className=\"flex-1 px-3 py-1.5 rounded-lg bg-black/40 border border-white/10 text-white placeholder-white/20 focus:outline-none focus:border-[#5b8cff] text-[11px]\"\n                />\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Package Structure Preview */}\n      <div className=\"p-5 rounded-2xl bg-[#12121c] border border-white/10 space-y-3\">\n        <h3 className=\"text-xs font-bold uppercase tracking-wider text-white/60 font-mono flex items-center gap-2\">\n          <FolderTree className=\"w-3.5 h-3.5 text-[#5b8cff]\" />\n          Output Package Hierarchy (.ZIP)\n        </h3>\n\n        <div className=\"p-4 rounded-xl bg-[#09090e] border border-white/10 font-mono text-xs text-white/70 overflow-x-auto leading-relaxed\">\n          {effectiveMode === \'static\' ? (\n            <div>\n              <span className=\"text-[#5b8cff] font-bold\">public_html/</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 index.html\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 .htaccess <span className=\"text-white/40\"># SPA routing & compression</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 favicon.svg <span className=\"text-white/40\"># Brand asset</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 robots.txt &amp; sitemap.xml <span className=\"text-white/40\"># SEO directives</span>\n              <br />\n              &nbsp;&nbsp;\342\224\224\342\224\200\342\224\200 assets/ <span className=\"text-white/40\"># Bundled styles, scripts, images</span>\n              <br />\n              <span className=\"text-[#3ddc8c]\">HOSTINGER_DEPLOYMENT.md</span> <span className=\"text-white/40\"># Step-by-step guide</span>\n              <br />\n              <span className=\"text-[#ffb547]\">conversion-report.html</span> <span className=\"text-white/40\"># Interactive audit summary</span>\n              <br />\n              {envVars.length > 0 && <span>.env.example</span>}\n            </div>\n          ) : effectiveMode === \'node\' ? (\n            <div>\n              <span className=\"text-[#5b8cff] font-bold\">app/</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 package.json <span className=\"text-white/40\"># Start scripts & Node engine</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 server.js / index.js\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 .env.example\n              <br />\n              &nbsp;&nbsp;\342\224\224\342\224\200\342\224\200 src/ &amp; public/\n              <br />\n              <span className=\"text-[#3ddc8c]\">HOSTINGER_DEPLOYMENT.md</span>\n              <br />\n              <span className=\"text-[#ffb547]\">conversion-report.html</span>\n            </div>\n          ) : (\n            <div>\n              <span className=\"text-[#5b8cff] font-bold\">public_html/</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 index.php <span className=\"text-white/40\"># Main application</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 config.php <span className=\"text-white/40\"># MySQL PDO connection</span>\n              <br />\n              &nbsp;&nbsp;\342\224\224\342\224\200\342\224\200 .htaccess\n              <br />\n              <span className=\"text-[#3ddc8c]\">HOSTINGER_DEPLOYMENT.md</span>\n              <br />\n              {analysis.database && <span>database-migration/ <span className=\"text-white/40\"># SQL schema</span></span>}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Build CTA Card */}\n      <div className=\"p-6 rounded-2xl bg-gradient-to-r from-[#5b8cff]/15 via-[#7c5cff]/10 to-transparent border border-[#5b8cff]/30 flex flex-col sm:flex-row items-center justify-between gap-4\">\n        <div>\n          <div className=\"font-extrabold text-sm text-white mb-1\">\n            Ready to Generate Hostinger Package\n          </div>\n          <div className=\"text-xs text-white/60\">\n            Produces a self-contained, validated <code className=\"text-[#9bb8ff] font-mono\">website-hostinger-ready.zip</code> archive.\n          </div>\n        </div>\n\n        <button\n          onClick={onBuild}\n          disabled={isBuilding}\n          className=\"w-full sm:w-auto flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl text-xs font-bold bg-gradient-to-r from-[#5b8cff] to-[#7c5cff] hover:opacity-95 text-white disabled:opacity-50 transition-all shadow-xl shadow-[#5b8cff]/25 shrink-0\"\n        >\n          {isBuilding ? (\n            <>\n              <div className=\"w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n              <span>Building Package...</span>\n            </>\n          ) : (\n            <>\n              <Package className=\"w-4 h-4\" />\n              <span>Build Deployment Package</span>\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* Navigation Footer */}\n      <div className=\"flex items-center justify-between pt-2\">\n        <button\n          onClick={onPrev}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/[0.05] hover:bg-white/[0.1] text-white transition-colors border border-white/10\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Repairs</span>\n        </button>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-800\">\n        <div>\n          <h1 className=\"text-xl font-extrabold text-white flex items-center gap-2.5\">\n            <Cpu className=\"w-5 h-5 text-indigo-400\" />\n            Hostinger Build &amp; Packaging Configuration\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Target Hostinger infrastructure: <strong className=\"text-indigo-300 font-mono\">{effectiveMode.toUpperCase()}</strong>\n          </p>\n        </div>\n      </div>\n\n      {/* Deployment Mode Selection Bento Grid */}\n      <div className=\"space-y-3\">\n        <h2 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono\">\n          Select Deployment Target\n        </h2>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n          {modeOptions.map((opt) => {\n            const isSelected = effectiveMode === opt.id;\n            const isRec = recommendedMode === opt.id;\n\n            return (\n              <div\n                key={opt.id}\n                onClick={() => onSelectMode(opt.id)}\n                className={`p-4 rounded-2xl border cursor-pointer transition-all ${\n                  isSelected\n                    ? \'bg-indigo-600/15 border-indigo-500 shadow-md shadow-indigo-500/10\'\n                    : \'bg-slate-900/60 backdrop-blur-md border-slate-800 hover:border-slate-700\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between mb-2\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <span className=\"text-xl\">{opt.icon}</span>\n                    <span className=\"font-bold text-xs text-white\">{opt.title}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5\">\n                    {isRec && (\n                      <span className=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30\">\n                        RECOMMENDED\n                      </span>\n                    )}\n                    {isSelected && (\n                      <span className=\"w-2 h-2 rounded-full bg-indigo-500 animate-pulse\" />\n                    )}\n                  </div>\n                </div>\n                <p className=\"text-[11px] text-slate-400 leading-relaxed\">{opt.desc}</p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Environment Variables Bento Card */}\n      <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 space-y-4 shadow-sm\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-white font-mono flex items-center gap-2\">\n              <KeyRound className=\"w-3.5 h-3.5 text-indigo-400\" />\n              Environment Variables ({envVars.length})\n            </h3>\n            <p className=\"text-[11px] text-slate-400 mt-0.5\">\n              These will be structured into <code className=\"text-slate-200 font-mono\">.env.example</code> for your Hostinger hPanel setup.\n            </p>\n          </div>\n        </div>\n\n        {envVars.length === 0 ? (\n          <div className=\"py-6 text-center text-xs text-slate-500 border border-slate-800/80 rounded-2xl bg-slate-950/40\">\n            No environment variables required for this project.\n          </div>\n        ) : (\n          <div className=\"space-y-2 max-h-60 overflow-y-auto\">\n            {envVars.map((v, idx) => (\n              <div\n                key={v.name}\n                className=\"flex items-center gap-3 p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-xs font-mono\"\n              >\n                <span className=\"text-indigo-300 font-semibold w-1/3 truncate\">{v.name}</span>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. your-api-key (optional preview value)\"\n                  value={v.value}\n                  onChange={(e) => onUpdateEnvVar(idx, e.target.value)}\n                  className=\"flex-1 px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 text-[11px]\"\n                />\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Package Structure Preview Bento Card */}\n      <div className=\"p-6 rounded-3xl bg-slate-900/60 backdrop-blur-md border border-slate-800 space-y-3 shadow-sm\">\n        <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center gap-2\">\n          <FolderTree className=\"w-3.5 h-3.5 text-indigo-400\" />\n          Output Package Hierarchy (.ZIP)\n        </h3>\n\n        <div className=\"p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 overflow-x-auto leading-relaxed\">\n          {effectiveMode === \'static\' ? (\n            <div>\n              <span className=\"text-indigo-400 font-bold\">public_html/</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 index.html\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 .htaccess <span className=\"text-slate-500\"># SPA routing & compression</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 favicon.svg <span className=\"text-slate-500\"># Brand asset</span>\n              <br />\n              &nbsp;&nbsp;\342\224\234\342\224\200\342\224\200 robots.txt &amp; sitemap.xml <span className=\"text-slate-500\"># SEO directives</span>\n              <br />\n              &nbsp