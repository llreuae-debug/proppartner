    instruction: "Remove GitHub OAuth routes and user repos route from server.ts"
    replacement_infos {
      original_chunk {
        target_content: "  // GitHub OAuth: Get Auth URL\n  app.get(\"/api/auth/github/url\", (req, res) => {\n    const clientId = process.env.GITHUB_CLIENT_ID || process.env.CLIENT_ID;\n    const appUrl = process.env.APP_URL || `${req.protocol}://${req.get(\"host\")}`;\n    const redirectUri = `${appUrl.replace(/\\/$/, \"\")}/auth/github/callback`;\n\n    if (!clientId) {\n      return res.json({\n        configured: false,\n        clientId: null,\n        redirectUri,\n        message: \"GITHUB_CLIENT_ID not configured in server environment.\",\n      });\n    }\n\n    const params = new URLSearchParams({\n      client_id: clientId,\n      redirect_uri: redirectUri,\n      scope: \"repo,read:user,user:email\",\n      state: `godeploy_${Date.now()}_${Math.random().toString(36).substring(2, 8)}`,\n    });\n\n    res.json({\n      configured: true,\n      clientId,\n      redirectUri,\n      url: `https://github.com/login/oauth/authorize?${params.toString()}`,\n    });\n  });\n\n  // GitHub OAuth: Callback handler for popup flow\n  const githubCallbackHandler = async (req: express.Request, res: express.Response) => {\n    const { code, error, error_description } = req.query;\n\n    if (error || !code) {\n      const errorMsg = (error_description as string) || (error as string) || \"Access denied or missing authorization code\";\n      return res.send(`\n        <!DOCTYPE html>\n        <html>\n        <head><title>GitHub Auth Failed</title></head>\n        <body style=\"background:#09090f;color:#fff;font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;\">\n          <div style=\"text-align:center;padding:32px;max-width:400px;background:#1e293b;border-radius:16px;border:1px solid rgba(244,63,94,0.3);\">\n            <h2 style=\"color:#f43f5e;font-size:18px;margin-bottom:8px;\">Authentication Failed</h2>\n            <p style=\"color:#94a3b8;font-size:13px;line-height:1.5;\">${errorMsg.replace(/</g, \"&lt;\")}</p>\n          </div>\n          <script>\n            if (window.opener) {\n              window.opener.postMessage({ type: \'GITHUB_OAUTH_ERROR\', error: ${JSON.stringify(errorMsg)} }, \'*\');\n              setTimeout(() => window.close(), 2500);\n            }\n          </script>\n        </body>\n        </html>\n      `);\n    }\n\n    try {\n      const clientId = process.env.GITHUB_CLIENT_ID || process.env.CLIENT_ID;\n      const clientSecret = process.env.GITHUB_CLIENT_SECRET || process.env.CLIENT_SECRET;\n\n      if (!clientId || !clientSecret) {\n        throw new Error(\"GITHUB_CLIENT_ID or GITHUB_CLIENT_SECRET is missing in environment variables.\");\n      }\n\n      // Exchange code for access token\n      const tokenRes = await fetch(\"https://github.com/login/oauth/access_token\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          Accept: \"application/json\",\n          \"User-Agent\": \"GoDeploy-OAuth\",\n        },\n        body: JSON.stringify({\n          client_id: clientId,\n          client_secret: clientSecret,\n          code,\n        }),\n      });\n\n      const tokenData = await tokenRes.json();\n      if (tokenData.error || !tokenData.access_token) {\n        throw new Error(tokenData.error_description || tokenData.error || \"Failed to obtain access token from GitHub\");\n      }\n\n      const accessToken = tokenData.access_token;\n\n      // Fetch user profile\n      const userRes = await fetch(\"https://api.github.com/user\", {\n        headers: {\n          Authorization: `Bearer ${accessToken}`,\n          Accept: \"application/vnd.github.v3+json\",\n          \"User-Agent\": \"GoDeploy-OAuth\",\n        },\n      });\n\n      const userData = userRes.ok ? await userRes.json() : { login: \"github-user\" };\n\n      res.send(`\n        <!DOCTYPE html>\n        <html>\n        <head><title>GitHub Connected</title></head>\n        <body style=\"background:#09090f;color:#fff;font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;\">\n          <div style=\"text-align:center;padding:32px;max-width:420px;background:rgba(30,41,59,0.8);border-radius:20px;border:1px solid rgba(255,255,255,0.1);box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);\">\n            <div style=\"width:48px;height:48px;border-radius:50%;background:#4f46e5;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px;\">\342\234\223</div>\n            <h2 style=\"font-size:18px;font-weight:700;margin-bottom:8px;\">Connected to GitHub!</h2>\n            <p style=\"color:#94a3b8;font-size:13px;margin-bottom:16px;\">Welcome, <strong>${userData.login || \"User\"}</strong>. Closing window and loading your private repositories...</p>\n          </div>\n          <script>\n            if (window.opener) {\n              window.opener.postMessage({\n                type: \'GITHUB_OAUTH_SUCCESS\',\n                token: ${JSON.stringify(accessToken)},\n                user: ${JSON.stringify({\n                  login: userData.login,\n                  name: userData.name || userData.login,\n                  avatar_url: userData.avatar_url,\n                  html_url: userData.html_url,\n                  total_private_repos: userData.total_private_repos || 0,\n                  public_repos: userData.public_repos || 0,\n                })}\n              }, \'*\');\n              setTimeout(() => window.close(), 1000);\n            } else {\n              window.location.href = \'/\';\n            }\n          </script>\n        </body>\n        </html>\n      `);\n    } catch (err: any) {\n      const errorMsg = err.message || \"Failed to exchange GitHub authorization code\";\n      res.send(`\n        <!DOCTYPE html>\n        <html>\n        <head><title>GitHub Connection Error</title></head>\n        <body style=\"background:#09090f;color:#fff;font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;\">\n          <div style=\"text-align:center;padding:32px;max-width:420px;background:#1e293b;border-radius:20px;border:1px solid rgba(244,63,94,0.3);\">\n            <h2 style=\"color:#f43f5e;font-size:18px;margin-bottom:8px;\">OAuth Exchange Error</h2>\n            <p style=\"color:#94a3b8;font-size:13px;line-height:1.5;margin-bottom:16px;\">${errorMsg.replace(/</g, \"&lt;\")}</p>\n          </div>\n          <script>\n            if (window.opener) {\n              window.opener.postMessage({ type: \'GITHUB_OAUTH_ERROR\', error: ${JSON.stringify(errorMsg)} }, \'*\');\n              setTimeout(() => window.close(), 3000);\n            }\n          </script>\n        </body>\n        </html>\n      `);\n    }\n  };\n\n  app.get([\"/auth/github/callback\", \"/auth/github/callback/\", \"/auth/callback\", \"/auth/callback/\"], githubCallbackHandler);\n\n  // GitHub User Profile & Repositories List\n  app.post(\"/api/github/user-repos\", async (req, res) => {\n    try {\n      const authHeader = req.headers.authorization;\n      const token = (authHeader && authHeader.startsWith(\"Bearer \") ? authHeader.substring(7) : req.body.token) || \"\";\n\n      if (!token || typeof token !== \"string\" || !token.trim()) {\n        return res.status(401).json({ error: \"Missing GitHub authentication token\" });\n      }\n\n      const headers = {\n        Authorization: `Bearer ${token.trim()}`,\n        Accept: \"application/vnd.github.v3+json\",\n        \"User-Agent\": \"GoDeploy-Hostinger-Converter\",\n      };\n\n      // 1. Fetch user profile\n      const userRes = await fetch(\"https://api.github.com/user\", { headers });\n      if (!userRes.ok) {\n        if (userRes.status === 401) {\n          return res.status(401).json({ error: \"Invalid or expired GitHub token. Please re-authenticate.\" });\n        }\n        return res.status(userRes.status).json({ error: `GitHub API error: ${userRes.statusText}` });\n      }\n      const user = await userRes.json();\n\n      // 2. Fetch user repositories (up to 100 recent)\n      const reposRes = await fetch(\"https://api.github.com/user/repos?sort=updated&per_page=100&affiliation=owner,collaborator,organization_member\", {\n        headers,\n      });\n\n      let repos: any[] = [];\n      if (reposRes.ok) {\n        const rawRepos = await reposRes.json();\n        repos = rawRepos.map((r: any) => ({\n          id: r.id,\n          name: r.name,\n          full_name: r.full_name,\n          owner: r.owner?.login || \"\",\n          private: Boolean(r.private),\n          description: r.description || \"\",\n          default_branch: r.default_branch || \"main\",\n          stars: r.stargazers_count || 0,\n          forks: r.forks_count || 0,\n          language: r.language || \"\",\n          updated_at: r.updated_at,\n          html_url: r.html_url,\n        }));\n      }\n\n      res.json({\n        success: true,\n        user: {\n          login: user.login,\n          name: user.name || user.login,\n          avatar_url: user.avatar_url,\n          html_url: user.html_url,\n          total_private_repos: user.total_private_repos || 0,\n          public_repos: user.public_repos || 0,\n        },\n        repos,\n      });\n    } catch (err: any) {\n      res.status(500).json({ error: err.message || \"Failed to fetch GitHub repositories\" });\n    }\n  });\n\n  // Direct GitHub Repository Import Route\n  app.post(\"/api/github-import\", async (req, res) => {"
        replacement_content: "  // Direct GitHub Repository Import Route\n  app.post(\"/api/github-import\", async (req, res) => {"
      }
      num_matches: 1
    }
  }
